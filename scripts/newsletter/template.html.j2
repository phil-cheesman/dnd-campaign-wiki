<!doctype html>
{#
  The Alambor Chronicle — LOCKED "Illuminated" design (generalized from
  newsletter-mockups/email-illuminated.html). Rendered by build_draft.py from a
  per-episode content JSON. Design lives here; prose lives in content/e<N>.json.

  Conventions:
    {{ IMG.<token> }}   -> live hot-linked image URL (resolved by build_draft.py)
    *_html fields       -> trusted authored HTML, emitted with |safe (no escaping)
    plain scalars       -> autoescaped (poll URLs, labels)
  Email-client rules honored: table layout, fully-inlined styles, no <img> CIDs.
#}
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,500&display=swap');
  body{margin:0;padding:0;background:#d8d0bf;}
  a{color:#6a33b0;}
</style>
</head>
<body style="margin:0;padding:0;background:#d8d0bf;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;">{{ preview_text }}</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#d8d0bf;">
<tr><td align="center" style="padding:24px 12px 44px;">

  <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:600px;background:#fcfbf8;border:1px solid #a8842c;">

    <!-- masthead -->
    <tr><td align="center" style="padding:24px 30px 18px;border-bottom:1px solid #e3ddcf;">
      <img src="{{ IMG.logo }}" width="66" height="66" alt="Alambor" style="display:block;margin:0 auto 10px;border-radius:33px;">
      <div style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:bold;font-size:36px;letter-spacing:1px;color:#23211c;">The Alambor Chronicle</div>
      <div style="font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-size:15px;color:#75705f;margin-top:3px;">{{ tagline|safe }}</div>
    </td></tr>

    <!-- hero -->
    <tr><td style="padding:14px 18px 0;">
      <img src="{{ IMG.hero }}" width="564" alt="{{ title }}" style="display:block;width:100%;border:1px solid #a8842c;">
    </td></tr>
    <tr><td align="center" style="font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-size:14px;color:#75705f;padding:12px 30px 0;">{{ hero_caption_html|safe }}</td></tr>

    <tr><td align="center" style="color:#a8842c;font-size:16px;letter-spacing:6px;padding:22px 0 16px;">&#10087;</td></tr>

    <!-- title -->
    <tr><td align="center" style="padding:0 36px;">
      <div style="font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-size:15px;color:#a8842c;">Episode the {{ episode_ordinal }} &middot; {{ date_line }} &middot; {{ locations_line }}</div>
      <div style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:bold;font-size:42px;line-height:1.04;color:#23211c;margin:4px 0 6px;">{{ title }}</div>
      <div style="font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-size:15px;color:#75705f;line-height:1.4;">{{ dek_html|safe }}</div>
    </td></tr>

    <tr><td align="center" style="color:#a8842c;font-size:16px;letter-spacing:6px;padding:18px 0;">&#10087;</td></tr>

    <!-- previously -->
    <tr><td style="font-family:'Cormorant Garamond',Georgia,serif;font-size:18px;line-height:1.5;color:#36322b;padding:0 36px;">
      <span style="float:left;font-family:'Cormorant Garamond',Georgia,serif;font-weight:bold;font-size:62px;line-height:46px;color:#a8842c;padding:6px 10px 0 0;">{{ previously_dropcap }}</span>{{ previously_html|safe }}
    </td></tr>
    <tr><td align="center" style="padding:24px 36px 4px;">
      <a href="{{ recap_url }}" style="display:inline-block;background:#23211c;color:#fcfbf8;font-family:'Cormorant Garamond',Georgia,serif;font-weight:bold;font-size:17px;padding:11px 30px;border:1px solid #a8842c;text-decoration:none;">Read the full recap &rarr;</a>
    </td></tr>

    <tr><td align="center" style="color:#a8842c;font-size:16px;letter-spacing:6px;padding:22px 0 16px;">&#10087;</td></tr>

    <!-- heading into play day -->
    <tr><td style="padding:0 36px;">
      <div align="center" style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:bold;font-size:19px;text-transform:uppercase;letter-spacing:2px;color:#23211c;text-align:center;margin-bottom:12px;"><span style="color:#a8842c;font-size:11px;">&#11045;</span>&nbsp;&nbsp;Heading into {{ play_day }}&nbsp;&nbsp;<span style="color:#a8842c;font-size:11px;">&#11045;</span></div>
      <table width="100%" cellpadding="0" cellspacing="0" style="font-family:'Cormorant Garamond',Georgia,serif;font-size:17px;line-height:1.45;color:#36322b;">
        {% for t in heading_into %}<tr><td style="padding:8px 0;{% if not loop.last %}border-bottom:1px solid #efeadf;{% endif %}"><span style="color:#a8842c;">&#10087;</span> {{ t.html|safe }}</td></tr>
        {% endfor %}
      </table>
    </td></tr>

    <tr><td align="center" style="color:#a8842c;font-size:16px;letter-spacing:6px;padding:22px 0 16px;">&#10087;</td></tr>

    <!-- party status -->
    <tr><td style="padding:0 36px;">
      <div align="center" style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:bold;font-size:19px;text-transform:uppercase;letter-spacing:2px;color:#23211c;text-align:center;margin-bottom:8px;"><span style="color:#a8842c;font-size:11px;">&#11045;</span>&nbsp;&nbsp;Party Status&nbsp;&nbsp;<span style="color:#a8842c;font-size:11px;">&#11045;</span></div>
      <table width="100%" cellpadding="0" cellspacing="0" style="font-family:'Cormorant Garamond',Georgia,serif;">
        {% for pc in party %}<tr><td width="66" valign="middle" style="padding:9px 0;{% if not loop.last %}border-bottom:1px solid #efeadf;{% endif %}"><img src="{{ IMG[pc.slug] }}" width="50" alt="{{ pc.name }}" style="display:block;border-radius:8px;border:2px solid #a8842c;"></td>
            <td valign="middle" style="padding:9px 0 9px 14px;{% if not loop.last %}border-bottom:1px solid #efeadf;{% endif %}"><div style="font-weight:bold;font-size:18px;color:#23211c;">{{ pc.name }}{% if pc.tag_html %} <span style="font-style:italic;font-weight:normal;font-size:15px;color:#75705f;">{{ pc.tag_html|safe }}</span>{% endif %}</div><div style="font-size:15px;color:#36322b;">{{ pc.note_html|safe }}</div></td></tr>
        {% endfor %}
      </table>
      <div align="center" style="text-align:center;font-family:'Cormorant Garamond',Georgia,serif;font-size:16px;padding-top:12px;"><a href="{{ site }}/characters" style="color:#6a33b0;">Open the full party dashboard &rarr;</a></div>
    </td></tr>

    <tr><td align="center" style="color:#a8842c;font-size:16px;letter-spacing:6px;padding:22px 0 16px;">&#10087;</td></tr>

    <!-- by the numbers -->
    <tr><td style="padding:0 36px;">
      <div align="center" style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:bold;font-size:19px;text-transform:uppercase;letter-spacing:2px;color:#23211c;text-align:center;margin-bottom:10px;"><span style="color:#a8842c;font-size:11px;">&#11045;</span>&nbsp;&nbsp;By the Numbers&nbsp;&nbsp;<span style="color:#a8842c;font-size:11px;">&#11045;</span></div>
      <table width="100%" cellpadding="0" cellspacing="0" style="font-family:'Cormorant Garamond',Georgia,serif;text-align:center;"><tr>
        {% for n in by_the_numbers %}<td width="{{ (100 / by_the_numbers|length)|round|int }}%" align="center"><div style="font-weight:bold;font-size:40px;color:#a8842c;">{{ n.value }}</div><div style="font-style:italic;font-size:14px;color:#75705f;">{{ n.label_html|safe }}</div></td>
        {% endfor %}
      </tr></table>
    </td></tr>

    <tr><td align="center" style="color:#a8842c;font-size:16px;letter-spacing:6px;padding:22px 0 16px;">&#10087;</td></tr>

    <!-- crit watch -->
    <tr><td style="padding:0 36px;">
      <div align="center" style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:bold;font-size:19px;text-transform:uppercase;letter-spacing:2px;color:#23211c;text-align:center;margin-bottom:12px;"><span style="color:#a8842c;font-size:11px;">&#11045;</span>&nbsp;&nbsp;Crit Watch &amp; Dice of Shame&nbsp;&nbsp;<span style="color:#a8842c;font-size:11px;">&#11045;</span></div>
      <table width="100%" cellpadding="0" cellspacing="0" style="font-family:'Cormorant Garamond',Georgia,serif;"><tr>
        <td width="49%" align="center" valign="top" style="background:#f6efdd;border:1px solid #d8c79a;padding:14px 10px;"><div style="font-weight:bold;font-size:40px;color:#a8842c;">20</div><div style="font-weight:bold;font-size:18px;color:#23211c;">{{ crit_watch.crit.pc }}</div><div style="font-style:italic;font-size:14px;color:#75705f;line-height:1.3;">{{ crit_watch.crit.note_html|safe }}</div></td>
        <td width="2%">&nbsp;</td>
        <td width="49%" align="center" valign="top" style="background:#f3e3df;border:1px solid #d8a99a;padding:14px 10px;"><div style="font-weight:bold;font-size:40px;color:#b05a42;">1</div><div style="font-weight:bold;font-size:18px;color:#23211c;">{{ crit_watch.fumble.pc }}</div><div style="font-style:italic;font-size:14px;color:#75705f;line-height:1.3;">{{ crit_watch.fumble.note_html|safe }}</div></td>
      </tr></table>
      <div align="center" style="text-align:center;font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-size:14px;color:#75705f;padding:16px 0 10px;">{{ season_caption_html|safe }}</div>
      <table width="100%" cellpadding="0" cellspacing="0" style="font-family:'Cormorant Garamond',Georgia,serif;font-size:15px;color:#36322b;">
        {% for b in season_bars %}<tr><td width="78" style="padding:3px 0;">{{ b.name }}</td><td style="padding:3px 0;"><table width="100%" cellpadding="0" cellspacing="0"><tr>{% if b.pct > 0 %}<td width="{{ b.pct }}%"><table width="100%" cellpadding="0" cellspacing="0"><tr><td height="14" style="background:#a8842c;font-size:0;line-height:0;">&nbsp;</td></tr></table></td>{% endif %}{% if b.pct < 100 %}<td><table width="100%" cellpadding="0" cellspacing="0"><tr><td height="14" style="background:#efeadf;font-size:0;line-height:0;">&nbsp;</td></tr></table></td>{% endif %}</tr></table></td><td width="22" align="right" style="padding:3px 0 3px 8px;color:{{ '#a8842c' if b.count else '#b3ad9d' }};{% if b.count %}font-weight:bold;{% endif %}">{{ b.count }}</td></tr>
        {% endfor %}
      </table>
      <div align="center" style="text-align:center;font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-size:13px;color:#75705f;padding-top:8px;">{{ fumble_note_html|safe }}</div>
    </td></tr>

    <tr><td align="center" style="color:#a8842c;font-size:16px;letter-spacing:6px;padding:22px 0 16px;">&#10087;</td></tr>

    <!-- quote -->
    <tr><td align="center" style="font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-size:25px;line-height:1.34;color:#23211c;padding:0 40px;">{{ quote.text_html|safe }}</td></tr>
    <tr><td align="center" style="font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-size:14px;color:#75705f;padding:14px 40px 0;">{{ quote.attrib_html|safe }}</td></tr>

    {% if npc_spotlight %}
    <tr><td align="center" style="color:#a8842c;font-size:16px;letter-spacing:6px;padding:22px 0 16px;">&#10087;</td></tr>

    <!-- npc spotlight (conditional) -->
    <tr><td style="padding:0 36px;">
      <div align="center" style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:bold;font-size:19px;text-transform:uppercase;letter-spacing:2px;color:#23211c;text-align:center;margin-bottom:12px;"><span style="color:#a8842c;font-size:11px;">&#11045;</span>&nbsp;&nbsp;NPC Spotlight&nbsp;&nbsp;<span style="color:#a8842c;font-size:11px;">&#11045;</span></div>
      <table width="100%" cellpadding="0" cellspacing="0" style="font-family:'Cormorant Garamond',Georgia,serif;"><tr>
        <td width="100" valign="middle"><img src="{{ IMG[npc_spotlight.image] }}" width="64" alt="{{ npc_spotlight.name }}" style="display:block;border-radius:10px;border:2px solid #a8842c;"></td>
        <td valign="middle" style="padding-left:18px;font-size:17px;line-height:1.45;color:#36322b;">{{ npc_spotlight.body_html|safe }}</td>
      </tr></table>
    </td></tr>
    {% endif %}

    {% if extra_sections %}{% for s in extra_sections %}
    <tr><td align="center" style="color:#a8842c;font-size:16px;letter-spacing:6px;padding:22px 0 16px;">&#10087;</td></tr>

    <!-- rotating section: {{ s.heading }} -->
    <tr><td style="padding:0 36px;">
      <div align="center" style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:bold;font-size:19px;text-transform:uppercase;letter-spacing:2px;color:#23211c;text-align:center;margin-bottom:12px;"><span style="color:#a8842c;font-size:11px;">&#11045;</span>&nbsp;&nbsp;{{ s.heading }}&nbsp;&nbsp;<span style="color:#a8842c;font-size:11px;">&#11045;</span></div>
      <div style="font-family:'Cormorant Garamond',Georgia,serif;font-size:17px;line-height:1.5;color:#36322b;">{{ s.body_html|safe }}</div>
    </td></tr>
    {% endfor %}{% endif %}

    <tr><td align="center" style="color:#a8842c;font-size:16px;letter-spacing:6px;padding:22px 0 16px;">&#10087;</td></tr>

    {% if last_results %}
    <!-- last week's results -->
    <tr><td style="padding:0 36px 4px;">
      <div align="center" style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:bold;font-size:15px;text-transform:uppercase;letter-spacing:2px;color:#75705f;text-align:center;margin-bottom:10px;">Last week&rsquo;s ballot &middot; E{{ last_results.episode }} &middot; {{ last_results.total }} vote{{ 's' if last_results.total != 1 }}</div>
      <table width="100%" cellpadding="0" cellspacing="0" style="font-family:'Cormorant Garamond',Georgia,serif;font-size:15px;color:#23211c;">
        {% for r in last_results.rows %}<tr><td style="padding:3px 8px 3px 0;">{{ r.label }}</td><td width="150"><table width="100%" cellpadding="0" cellspacing="0"><tr>{% if r.pct > 0 %}<td width="{{ r.pct }}%"><table width="100%" cellpadding="0" cellspacing="0"><tr><td height="12" style="background:#a8842c;font-size:0;line-height:0;">&nbsp;</td></tr></table></td>{% endif %}{% if r.pct < 100 %}<td><table width="100%" cellpadding="0" cellspacing="0"><tr><td height="12" style="background:#efeadf;font-size:0;line-height:0;">&nbsp;</td></tr></table></td>{% endif %}</tr></table></td><td width="28" align="right" style="padding:3px 0 3px 8px;font-weight:bold;color:#a8842c;">{{ r.count }}</td></tr>
        {% endfor %}
      </table>
    </td></tr>
    <tr><td align="center" style="color:#a8842c;font-size:16px;letter-spacing:6px;padding:14px 0;">&#10087;</td></tr>
    {% endif %}

    <!-- cast your vote -->
    <tr><td style="padding:0 36px;">
      <div align="center" style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:bold;font-size:19px;text-transform:uppercase;letter-spacing:2px;color:#23211c;text-align:center;margin-bottom:12px;"><span style="color:#a8842c;font-size:11px;">&#11045;</span>&nbsp;&nbsp;Cast Your Vote&nbsp;&nbsp;<span style="color:#a8842c;font-size:11px;">&#11045;</span></div>
      <div align="center" style="text-align:center;font-family:'Cormorant Garamond',Georgia,serif;font-size:19px;font-weight:bold;color:#23211c;margin-bottom:8px;">{{ poll.question|safe }}</div>
      <table width="100%" cellpadding="0" cellspacing="0" style="font-family:'Cormorant Garamond',Georgia,serif;font-size:18px;">
        {% for o in poll.options %}<tr><td style="{% if not loop.last %}padding-bottom:8px;{% endif %}"><a href="{{ o.url }}" style="display:block;background:#fcfbf8;border:1px solid #d8c79a;padding:11px 16px;color:#23211c;text-decoration:none;"><span style="font-size:20px;">{{ o.emoji|safe }}</span>&nbsp;&nbsp;{{ o.label|safe }}</a></td></tr>
        {% endfor %}
      </table>
      <div align="center" style="text-align:center;font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-size:13px;color:#75705f;padding-top:8px;">One tap logs your vote &mdash; no form, no submit.</div>
    </td></tr>

    <tr><td align="center" style="color:#a8842c;font-size:16px;letter-spacing:6px;padding:22px 0 16px;">&#10087;</td></tr>

    <!-- next session -->
    <tr><td style="padding:0 36px 4px;">
      <table width="100%" cellpadding="0" cellspacing="0" style="background:#f6efdd;border:1px solid #a8842c;"><tr><td align="center" style="font-family:'Cormorant Garamond',Georgia,serif;padding:22px;">
        <div style="font-style:italic;color:#a8842c;font-size:15px;">Next Session</div>
        <div style="font-weight:bold;font-size:30px;color:#23211c;margin:4px 0;">{{ next_session.day }}</div>
        <div style="font-style:italic;color:#75705f;font-size:15px;">{{ next_session.teaser_html|safe }}</div>
      </td></tr></table>
    </td></tr>

    <!-- footer -->
    <tr><td align="center" style="padding:26px 34px 22px;">
      <div style="color:#a8842c;font-size:14px;letter-spacing:6px;margin-bottom:8px;">&#10022; &#11045; &#10022;</div>
      <div style="font-family:Georgia,serif;font-size:12px;line-height:1.9;color:#75705f;">
        <a href="{{ site }}/map" style="color:#75705f;">Map</a> &middot; <a href="{{ site }}/gallery" style="color:#75705f;">Gallery</a> &middot; <a href="{{ site }}/characters" style="color:#75705f;">Party</a> &middot; <a href="{{ site }}/changelog" style="color:#75705f;">Changelog</a><br>
        The Alambor Six<br>
        No unsubscribe button &mdash; you&rsquo;re in the party until death. &#9904;
      </div>
    </td></tr>

  </table>

</td></tr>
</table>
</body>
</html>

---
import MapLayout from '../layouts/MapLayout.astro';
import { getJourney } from '../lib/journey.ts';
import { getAtlas } from '../lib/atlas.ts';

const journey = getJourney();
const atlas = await getAtlas();
---

<MapLayout
  title="The Journey"
  description="Trace the Alambor Six across the world map — drag the journey, or click any stop."
>
  <div class="pagehead">
    <div>
      <h1>The World of Alambor</h1>
      <span class="sub">Browse every known place — or switch to Journey to trace the party's path</span>
      <a class="calibrate-link" id="calibrate-link" href="?calibrate">Marker positions are approximate — calibrate ↗</a>
    </div>
    <div class="controls">
      <!-- Journey nav (journey-only) and the region switcher (explore-only) are mutually
           exclusive and both sit left of the mode toggle. The toggle is kept last so,
           being right-aligned, its position never shifts between modes. -->
      <div class="journey-nav" id="journey-nav">
        <button class="btn" id="prev">← Prev</button>
        <button class="btn" id="next">Next →</button>
        <button class="btn play" id="play">▶ Play journey</button>
      </div>
      <div class="mapswitch" role="group" aria-label="Region" id="mapswitch">
        <button data-map="world" class="active" type="button">World</button>
        {Object.entries(atlas.regionMaps).map(([id, m]) => (
          <button data-map={id} type="button">{m.label}</button>
        ))}
      </div>
      <div class="modeswitch" role="group" aria-label="Map mode">
        <button data-mode="explore" class="active" type="button">Explore</button>
        <button data-mode="journey" type="button">Journey</button>
      </div>
    </div>
  </div>

  <div class="main">
    <div class="mapwrap">
      <div id="map"></div>
      <div class="maplegend">
        <div class="row"><span class="sw sw-traveled"></span> travelled route</div>
        <div class="row"><span class="sw sw-ahead"></span> the road ahead</div>
        <div class="row"><span class="sw sw-planar"></span> planar crossing</div>
      </div>
      <!-- Live journey position — floats in the open bottom-right corner; journey-only.
           The episode is a purple hotlink to its recap. -->
      <div class="readout" id="readout"></div>
      <div class="atlas-legend">
        <div class="row"><span class="lg-dot"></span> placed</div>
        <div class="row"><span class="lg-dot unplaced"></span> approximate</div>
        <div class="row"><span class="lg-dot planar"></span> planar</div>
        <div class="row"><span class="lg-dot faction"></span> faction</div>
      </div>
      <div class="calibrate-readout" id="calibrate" hidden></div>
    </div>

    <!-- Phone-only backdrop behind the atlas bottom sheet (tap to dismiss). Inert on
         desktop where the atlas is a docked column. -->
    <div class="atlas-backdrop" id="atlas-backdrop" aria-hidden="true"></div>

    <!-- Explore mode: collapsible index of every known place (a docked column on desktop;
         a collapsed-by-default bottom sheet on phones — see Phase 2 responsive CSS). -->
    <aside class="atlas" id="atlas-pane" aria-label="Place index">
      <div class="atlas-head">
        <div>
          <h2>Atlas</h2>
          <span class="atlas-count">{atlas.total} places · {atlas.placed} pinned</span>
        </div>
        <button class="atlas-close" id="atlas-close" type="button" aria-label="Hide index" title="Hide index">×</button>
      </div>
      <div class="atlas-filter">
        <input type="search" id="atlas-search" placeholder="Filter places…" autocomplete="off" spellcheck="false" />
      </div>
      <div class="atlas-slicers" role="group" aria-label="Slice the list">
        <button class="slicer" data-slice="articles" type="button" title="Only places with a wiki article">Articles</button>
        <button class="slicer" data-slice="visited" type="button" title="Only places the party has travelled to">Visited</button>
        <button class="slicer" data-slice="unpinned" type="button" title="Only approximate places awaiting calibration">Unpinned</button>
      </div>
      <div class="atlas-empty" id="atlas-empty" hidden>No places match.</div>
      <div class="atlas-groups" id="atlas-groups">
        {atlas.groups.map((g) => (
          <section class:list={['atlas-group', g.key === 'other' && 'collapsed']} data-group={g.key}>
            <div class="grp-head" role="button" tabindex="0" aria-expanded={String(g.key !== 'other')}>
              <span class="grp-toggle" aria-hidden="true"></span>
              {g.href ? <a class="grp-name" href={g.href}>{g.name}</a> : <span class="grp-name">{g.name}</span>}
              <span class="grp-count">{g.entries.length}</span>
            </div>
            <ul class="grp-list">
              {g.entries.map((e) => (
                <li
                  class="atlas-row"
                  data-key={e.key}
                  data-name={e.name.toLowerCase()}
                  data-article={e.href ? '1' : '0'}
                  data-visited={e.visited ? '1' : '0'}
                  data-placed={e.placed ? '1' : '0'}
                >
                  <button class="row-focus" type="button" title="Find on map">
                    {e.img ? (
                      <img class="row-thumb" src={e.img} alt="" loading="lazy" width="26" height="26" />
                    ) : (
                      <span class={`row-dot ${e.kind}${e.placed ? '' : ' unplaced'}${e.plane !== 'world' ? ' planar' : ''}`}></span>
                    )}
                    <span class="row-name">{e.name}</span>
                    {!e.placed && <span class="row-flag" title="Approximate — pin down later">~</span>}
                  </button>
                  {e.href && <a class="row-link" href={e.href} title="Open article" aria-label={`Open ${e.name} article`}>↗</a>}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </aside>
    <button class="atlas-reopen" id="atlas-reopen" type="button" title="Show place index">☰ Atlas</button>

    <aside class="card">
      <div class="kicker" id="c-kicker"></div>
      <h2 id="c-title"></h2>
      <div class="chips" id="c-chips"></div>
      <p class="blurb" id="c-blurb"></p>
      <h5>Key beats</h5>
      <ul class="beats" id="c-beats"></ul>
      <h5>All stops</h5>
      <div class="stop-dots" id="c-dots"></div>
      <div class="links" id="c-links"></div>
    </aside>
  </div>

  <!-- Timeline scrubber (3b): arc bands + per-stop ticks + draggable playhead. Prev/Next/
       Play live in the topbar; the live readout floats over the map. Animates in when
       Journey mode is entered (see .timeline animation). Journey mode only. -->
  <div class="timeline">
    <div class="tl-top">
      <span>E00</span>
      <span id="tl-mid"></span>
      <span>E{journey.maxEpisode}</span>
    </div>
    <div class="track" id="track">
      <div class="arcs" id="arcbands"></div>
      <div class="playhead" id="playhead"><div class="head"></div><div class="stem"></div></div>
    </div>
    <div class="arc-labels" id="arclabels"></div>
  </div>

  <!-- Server data → client. (Bundled module scripts can't use define:vars, so hand off via JSON.) -->
  <script type="application/json" id="journey-data" set:html={JSON.stringify(journey)}></script>
  <script type="application/json" id="atlas-data" set:html={JSON.stringify(atlas)}></script>

  <script>
    import L from 'leaflet';
    import 'leaflet/dist/leaflet.css';

    interface Stop {
      title: string; arc: number; episodes: [number, number];
      blurb: string; beats: string[];
      place: string; x: number; y: number;
      plane: 'world' | 'avernus' | 'shadowfell';
      dossier: string | null; cityMap: string | null;
    }
    interface Arc { n: string; title: string; start: number; end: number; color: string; dossier: string | null; }
    interface Journey {
      maxEpisode: number;
      map: { image: string; width: number; height: number };
      arcs: Arc[];
      stops: Stop[];
    }

    interface RegionPos { x: number; y: number; placed: boolean; }
    interface AtlasEntry {
      key: string; name: string; kind: 'location' | 'faction';
      x: number; y: number; placed: boolean; visited: boolean;
      plane: 'world' | 'avernus' | 'shadowfell';
      href: string | null; img: string | null; blurb: string | null; group: string;
      regions?: Record<string, RegionPos>;
    }
    interface AtlasGroup { key: string; name: string; href: string | null; img: string | null; entries: AtlasEntry[]; }
    interface RegionMap { image: string; width: number; height: number; label: string; group: string | null; parent: string; }
    interface Atlas { groups: AtlasGroup[]; total: number; placed: number; regionMaps: Record<string, RegionMap>; }

    const data: Journey = JSON.parse(document.getElementById('journey-data')!.textContent!);
    const atlas: Atlas = JSON.parse(document.getElementById('atlas-data')!.textContent!);
    const { stops, arcs, map: meta, maxEpisode } = data;
    // The active base-image dimensions. Mutable: Explore can drill into a regional map
    // (3c), which swaps the base image + bounds. Journey is always the world map.
    let W = meta.width, H = meta.height;
    const CALIBRATE = new URLSearchParams(location.search).has('calibrate');

    const epSlug = (n: number) => 'e' + String(n).padStart(3, '0');

    // ---------- Leaflet map (CRS.Simple over the raster world map) ----------
    const map = L.map('map', {
      crs: L.CRS.Simple,
      minZoom: -2,
      maxZoom: 2,
      // Coarser zoom steps + slower wheel = far fewer per-step image re-scales than the
      // old zoomSnap:0.25, which (with the 6.5 MB overlay) was the source of the wheel lag.
      zoomSnap: 0.5,
      zoomDelta: 0.5,
      wheelPxPerZoomLevel: 130,
      wheelDebounceTime: 40,
      zoomControl: true,
      attributionControl: false,
    });
    // unproject at native zoom 0 → pixel (0,0) is top-left, (W,H) bottom-right,
    // which matches our normalised (x = frac from left, y = frac from top).
    const px = (x: number, y: number) => map.unproject([x, y], 0);
    const ll = (s: { x: number; y: number }) => px(s.x * W, s.y * H);
    let bounds = L.latLngBounds(px(0, 0), px(W, H));
    let baseOverlay = L.imageOverlay(meta.image, bounds).addTo(map);
    // Inset the sheet so the atmospheric surround (deep sea-ink vignette, see CSS) reads
    // as an intentional margin around the map, not a thin seam. Re-inset on resize.
    // animate:false — when swapping between *different* base images (world ↔ a region),
    // an eased pan/zoom between two unrelated maps just jerks through nonsense positions,
    // so we snap straight to the new frame instead.
    const fit = () => map.fitBounds(bounds, { padding: [120, 120], animate: false });
    // Reframe after a base/layout change: settle the container size, then snap to fit.
    const frameBase = () => { map.invalidateSize(); fit(); };
    fit();
    map.setMaxBounds(bounds.pad(0.5));
    window.addEventListener('resize', fit);

    // Swap the base raster (world ↔ a regional image, 3c). Recomputes W/H/bounds so all
    // the normalised-coord helpers (ll, scatter) land correctly on the new image's aspect.
    function setBase(m: { image: string; width: number; height: number }) {
      W = m.width; H = m.height;
      bounds = L.latLngBounds(px(0, 0), px(W, H));
      map.removeLayer(baseOverlay);
      baseOverlay = L.imageOverlay(m.image, bounds).addTo(map);
      map.setMaxBounds(bounds.pad(0.5));
    }

    // Journey chrome (route + stop markers + party) lives in its own layer group so
    // Explore can swap it out wholesale for the atlas layer (no CSS-hiding hacks).
    const journeyLayer = L.layerGroup().addTo(map);

    // ---------- route legs (drawn under markers) ----------
    const legPolys: L.Polyline[] = [];
    for (let i = 1; i < stops.length; i++) {
      const a = stops[i - 1], b = stops[i];
      const planar = a.plane !== 'world' || b.plane !== 'world';
      const poly = L.polyline([ll(a), ll(b)], {
        className: 'leg' + (planar ? ' planar' : ''),
        interactive: false,
      }).addTo(journeyLayer);
      legPolys.push(poly);
    }

    // ---------- location markers (dedupe revisited places) ----------
    const placeOrder = new Map<string, number[]>(); // place key → stop indices, in order
    stops.forEach((s, i) => {
      if (!placeOrder.has(s.place)) placeOrder.set(s.place, []);
      placeOrder.get(s.place)!.push(i);
    });

    const placeMarkers = new Map<string, L.Marker>();
    placeOrder.forEach((idxs, place) => {
      const s = stops[idxs[0]];
      const planar = s.plane !== 'world';
      const label = s.place === 'kierkenwall' ? 'Kierkenwall' : labelFor(s);
      const icon = L.divIcon({
        className: 'mk-wrap',
        html: `<span class="mk-dot${planar ? ' planar' : ''}"></span><span class="mk-label">${label}</span>`,
        iconSize: [0, 0],
        iconAnchor: [0, 0],
      });
      const m = L.marker(ll(s), { icon, riseOnHover: true }).addTo(journeyLayer);
      m.on('click', () => {
        // Journey mode only (the layer is swapped out in Explore): clicking a place
        // advances to its next stop after the current one.
        const next = idxs.find((i) => i > current) ?? idxs[0];
        goToStop(next);
        rippleAt(m);
      });
      placeMarkers.set(place, m);
    });

    // One-shot select ripple on a marker. Skipped under reduced-motion (the map
    // layout has no global reduced-motion reset, so gate it here).
    const reduceMotion =
      typeof window.matchMedia === 'function' &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function rippleAt(marker: L.Marker) {
      if (reduceMotion) return;
      const el = marker.getElement();
      if (!el) return;
      const r = document.createElement('span');
      r.className = 'mk-ripple';
      r.addEventListener('animationend', () => r.remove());
      el.appendChild(r);
    }

    function labelFor(s: Stop): string {
      // Prefer a human place label from the title's location feel; fall back to the place key.
      return s.place
        .split('-')
        .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
        .join(' ');
    }

    // ---------- party marker ----------
    const partyIcon = L.divIcon({
      className: 'party-wrap',
      html: '<span class="party-pulse"></span><span class="party-diamond"></span>',
      iconSize: [0, 0],
      iconAnchor: [0, 0],
    });
    const party = L.marker(ll(stops[stops.length - 1]), {
      icon: partyIcon,
      interactive: false,
      zIndexOffset: 1000,
    }).addTo(journeyLayer);

    // ---------- Explore / Atlas layer (every known place, swapped in for journey chrome) ----------
    const atlasLayer = L.layerGroup();
    const atlasEntries = atlas.groups.flatMap((g) => g.entries);
    const entryByKey = new Map<string, AtlasEntry>();
    const atlasMarkers = new Map<string, L.Marker>();

    // `placed` varies by active map (a place can be calibrated on the world map but only
    // scattered on its region map, or vice-versa), so the icon is rebuilt on map switch.
    function makeAtlasIcon(e: AtlasEntry, placed: boolean) {
      const planar = e.plane !== 'world';
      const cls = `ax-dot ${e.kind}${placed ? '' : ' unplaced'}${planar ? ' planar' : ''}`;
      return L.divIcon({
        className: 'ax-wrap',
        html: `<span class="${cls}"></span><span class="ax-label">${e.name}</span>`,
        iconSize: [0, 0],
        iconAnchor: [0, 0],
      });
    }

    for (const e of atlasEntries) {
      entryByKey.set(e.key, e);
      const m = L.marker(ll(e), { icon: makeAtlasIcon(e, e.placed), riseOnHover: true }).addTo(atlasLayer);
      m.on('click', () => openAtlas(e, m));
      atlasMarkers.set(e.key, m);
    }

    // ---------- regional map drill-down (3c): explore can swap world → a region ----------
    // exploreMap = which map Explore is showing ('world' | region id). Journey is world-only.
    let exploreMap = 'world';
    let activeGroup: string | null = null; // atlas group the index is cross-filtered to

    // Position + show/hide every atlas marker for the active explore map, swap the base
    // image, cross-filter the index, and reflect the choice in the buttons/breadcrumb/URL.
    function renderExploreMap() {
      const region = exploreMap === 'world' ? null : atlas.regionMaps[exploreMap];
      setBase(region ?? meta);

      for (const e of atlasEntries) {
        const m = atlasMarkers.get(e.key)!;
        // world → always shown at its world coord; region → only its members, at the
        // region coord (real or scattered), hidden otherwise.
        const rp = region ? e.regions?.[exploreMap] : { x: e.x, y: e.y, placed: e.placed };
        if (rp) {
          m.setIcon(makeAtlasIcon(e, rp.placed));
          m.setLatLng(ll(rp));
          if (!atlasLayer.hasLayer(m)) m.addTo(atlasLayer);
        } else if (atlasLayer.hasLayer(m)) {
          atlasLayer.removeLayer(m);
        }
      }

      activeGroup = region ? region.group : null;
      applyFilter();

      mapBtns.forEach((b) => b.classList.toggle('active', b.dataset.map === exploreMap));
      if (subEl) {
        subEl.textContent = region
          ? `World ▸ ${region.label} · regional map`
          : `Atlas · ${atlas.total} places · click any pin or index row`;
      }
      updateCalibrateLink();
      // Snap to the new image now (kills the one-frame mis-framed flash), then again after
      // layout settles (a mode-toggle also resized the container). Both snaps are silent.
      frameBase();
      requestAnimationFrame(frameBase);
    }

    function setExploreMap(id: string) {
      const valid = id === 'world' || !!atlas.regionMaps[id];
      exploreMap = valid ? id : 'world';
      if (mode !== 'explore') { setMode('explore'); return; } // setMode re-renders the map
      const u = new URL(location.href);
      if (exploreMap === 'world') u.searchParams.delete('map');
      else u.searchParams.set('map', exploreMap);
      history.replaceState(null, '', u);
      map.closePopup();
      renderExploreMap();
    }

    // Keep the header "calibrate ↗" link pointed at the active map (so calibrating lands
    // on the region you're looking at), preserving the current mode.
    const calibrateLink = document.getElementById('calibrate-link') as HTMLAnchorElement | null;
    function updateCalibrateLink() {
      if (!calibrateLink) return;
      const parts = ['calibrate'];
      if (exploreMap !== 'world') parts.push('map=' + exploreMap);
      if (mode === 'journey') parts.push('mode=journey');
      calibrateLink.href = '?' + parts.join('&');
    }

    function openAtlas(e: AtlasEntry, marker: L.Marker) {
      const kind =
        e.kind === 'faction'
          ? 'Faction'
          : e.plane !== 'world'
            ? `◆ ${e.plane} (via portal)`
            : 'Location';
      const thumb = e.img ? `<img class="xp-thumb" src="${e.img}" alt="" />` : '';
      const blurb = e.blurb ? `<p>${e.blurb}</p>` : '';
      const flag = e.placed ? '' : `<div class="xp-flag">Approximate spot — not yet pinned down</div>`;
      const more = e.href ? `<a href="${e.href}">Read more →</a>` : '';
      // On a phone the map pane is narrow, so a fixed 280px bubble overshoots the
      // viewport and a long blurb runs off the bottom. Cap width to the viewport
      // (minus gutters) and give the body a scrollable max height.
      const maxW = Math.min(280, window.innerWidth - 32);
      const maxH = Math.max(180, Math.round(window.innerHeight * 0.6));
      marker
        .bindPopup(
          `<div class="xp atlas">${thumb}<div class="xp-kind">${kind}</div><h3>${e.name}</h3>${blurb}${flag}${more}</div>`,
          { className: 'xpop', maxWidth: maxW, maxHeight: maxH, autoPan: true },
        )
        .openPopup();
    }

    // Focus a place from the index: ensure Explore, recentre, open its popup.
    function focusEntry(key: string) {
      const e = entryByKey.get(key);
      const m = atlasMarkers.get(key);
      if (!e || !m) return;
      if (mode !== 'explore') setMode('explore');
      // If the place isn't on the active region map, pop back to the world map so its
      // marker exists to focus.
      if (!atlasLayer.hasLayer(m)) setExploreMap('world');
      // Open first, then pan — opening during an in-flight pan animation can drop the
      // popup; with it already open, panTo just carries it into view. Use the marker's
      // live position (it differs per map), not the world coord.
      openAtlas(e, m);
      map.panTo(m.getLatLng(), { animate: true, duration: 0.5 });
    }

    // ---------- timeline scrubber (arc bands + ticks + playhead) ----------
    const track = document.getElementById('track')!;
    const bands = document.getElementById('arcbands')!;
    const arcLabels = document.getElementById('arclabels')!;
    const playhead = document.getElementById('playhead')!;
    document.getElementById('tl-mid')!.textContent =
      `The Campaign · ${arcs.length} arcs · E00–E${maxEpisode}`;

    // arc bands (width ∝ episode span) + a label centred under each
    arcs.forEach((a) => {
      const band = document.createElement('div');
      band.className = 'arcband';
      band.style.width = ((a.end - a.start + 1) / (maxEpisode + 1)) * 100 + '%';
      band.style.background = a.color;
      band.title = `Arc ${a.n} — ${a.title} (E${a.start}–E${a.end})`;
      band.addEventListener('click', (e) => { e.stopPropagation(); setEp(a.start); });
      bands.appendChild(band);

      const lab = document.createElement('span');
      lab.style.left = (((a.start + a.end) / 2) / maxEpisode) * 100 + '%';
      lab.textContent = a.title;
      arcLabels.appendChild(lab);
    });

    // one tick per stop, positioned at its first episode
    const ticks = stops.map((s, i) => {
      const t = document.createElement('div');
      t.className = 'tick';
      t.style.left = (s.episodes[0] / maxEpisode) * 100 + '%';
      t.title = `${s.title} (E${s.episodes[0]})`;
      t.addEventListener('click', (e) => { e.stopPropagation(); goToStop(i); });
      track.appendChild(t);
      return t;
    });

    // ---------- state ----------
    type Mode = 'journey' | 'explore';
    // Explore is the default view; Journey is opt-in (?mode=journey). A ?map=<region>
    // deep-links into a regional map (Explore-only), e.g. /map?map=gidia.
    const params = new URLSearchParams(location.search);
    let mode: Mode = params.get('mode') === 'journey' ? 'journey' : 'explore';
    const mapParam = params.get('map');
    if (mapParam && atlas.regionMaps[mapParam]) {
      exploreMap = mapParam;
      if (mode !== 'journey') mode = 'explore';
    }
    let current = stops.length - 1;
    let ep = stops[current].episodes[0]; // playhead position, measured in episodes
    let playing: ReturnType<typeof setInterval> | null = null;

    // The "current" stop for an episode = the last stop that has started by then.
    function stopForEp(e: number): number {
      let idx = 0;
      stops.forEach((s, i) => { if (s.episodes[0] <= e) idx = i; });
      return idx;
    }

    function setEp(e: number, snap = true) {
      ep = Math.max(0, Math.min(maxEpisode, Math.round(e)));
      current = stopForEp(ep);
      if (snap) ep = Math.max(ep, stops[current].episodes[0]);
      render();
    }

    function goToStop(i: number) {
      current = Math.max(0, Math.min(stops.length - 1, i));
      ep = stops[current].episodes[0];
      render();
    }

    function render() {
      const s = stops[current];
      const arc = arcs[s.arc];

      party.setLatLng(ll(s));
      map.panTo(ll(s), { animate: true, duration: 0.6 });

      legPolys.forEach((p, i) => {
        const el = (p as any).getElement?.() as SVGElement | undefined;
        if (el) el.classList.toggle('traveled', i < current);
      });

      placeOrder.forEach((idxs, place) => {
        const visited = idxs.some((i) => i <= current);
        const here = idxs.includes(current);
        const el = placeMarkers.get(place)!.getElement();
        if (el) {
          el.classList.toggle('visited', visited && !here);
          el.classList.toggle('here', here);
        }
      });

      // timeline: move the playhead, mark started ticks, light the active arc band
      playhead.style.left = (ep / maxEpisode) * 100 + '%';
      ticks.forEach((t, i) => t.classList.toggle('done', i <= current));
      Array.from(bands.children).forEach((b, i) => (b as HTMLElement).classList.toggle('on', i === s.arc));

      // readout — the episode links to its recap (opens the article)
      const readout = document.getElementById('readout')!;
      readout.innerHTML =
        `<a href="/episodes/${epSlug(ep)}" title="Open E${ep} recap">E${ep}</a>` +
        ` · Arc ${arc.n} — ${arc.title} · stop ${current + 1} of ${stops.length}`;

      // card
      document.getElementById('c-kicker')!.textContent = `Stop ${current + 1} of ${stops.length} · Arc ${arc.n} — ${arc.title}`;
      document.getElementById('c-title')!.textContent = s.title;

      const chips = [`E${s.episodes[0]}–E${s.episodes[1]}`, labelFor(s)];
      document.getElementById('c-chips')!.innerHTML =
        chips.map((c) => `<span class="chip">${c}</span>`).join('') +
        (s.plane !== 'world' ? `<span class="chip plane">◆ ${s.plane}</span>` : '');

      document.getElementById('c-blurb')!.textContent = s.blurb;
      document.getElementById('c-beats')!.innerHTML = s.beats.map((b) => `<li>${b}</li>`).join('');

      document.getElementById('c-dots')!.innerHTML = stops
        .map((st, i) => `<span class="${i < current ? 'done' : i === current ? 'now' : ''}" data-i="${i}" title="${st.title}"></span>`)
        .join('');
      document.querySelectorAll<HTMLElement>('#c-dots span').forEach((d) =>
        d.addEventListener('click', () => goToStop(Number(d.dataset.i))),
      );

      const links: string[] = [];
      if (arc.dossier) links.push(`<a href="/arcs/${arc.dossier}">Read Arc ${arc.n} →</a>`);
      links.push(`<a href="/episodes/${epSlug(s.episodes[0])}">Episode E${s.episodes[0]} →</a>`);
      if (s.dossier) links.push(`<a href="/locations/${s.dossier}">${labelFor(s)} →</a>`);
      document.getElementById('c-links')!.innerHTML = links.join('');
    }

    // ---------- controls ----------
    document.getElementById('prev')!.addEventListener('click', () => goToStop(current - 1));
    document.getElementById('next')!.addEventListener('click', () => goToStop(current + 1));
    document.addEventListener('keydown', (e) => {
      if (mode === 'explore') return;
      if (e.key === 'ArrowLeft') goToStop(current - 1);
      if (e.key === 'ArrowRight') goToStop(current + 1);
    });

    // drag (or click) anywhere on the track to scrub the playhead by episode
    function trackEp(evt: PointerEvent): number {
      const r = track.getBoundingClientRect();
      return ((evt.clientX - r.left) / r.width) * maxEpisode;
    }
    let dragging = false;
    track.addEventListener('pointerdown', (e) => {
      dragging = true; track.setPointerCapture(e.pointerId); setEp(trackEp(e), false);
    });
    track.addEventListener('pointermove', (e) => { if (dragging) setEp(trackEp(e), false); });
    track.addEventListener('pointerup', () => { dragging = false; });

    const playBtn = document.getElementById('play')!;
    playBtn.addEventListener('click', () => {
      if (playing) {
        clearInterval(playing); playing = null; playBtn.textContent = '▶ Play journey'; return;
      }
      if (current >= stops.length - 1) goToStop(0);
      playBtn.textContent = '⏸ Pause';
      playing = setInterval(() => {
        if (current >= stops.length - 1) {
          clearInterval(playing!); playing = null; playBtn.textContent = '▶ Play journey'; return;
        }
        goToStop(current + 1);
      }, 2400);
    });

    // ---------- calibration helper (?calibrate) ----------
    if (CALIBRATE) {
      const box = document.getElementById('calibrate')!;
      box.hidden = false;
      box.textContent = 'Click the map to copy normalised x,y →';
      map.on('click', (e: L.LeafletMouseEvent) => {
        const p = map.project(e.latlng, 0); // back to pixel space (in the active map's W/H)
        const x = +(p.x / W).toFixed(3);
        const y = +(p.y / H).toFixed(3);
        // World → paste into the place's top-level x,y. Region → paste into its `on:` map.
        const snippet =
          exploreMap === 'world'
            ? `{ x: ${x}, y: ${y} }`
            : `on: { ${exploreMap}: { x: ${x}, y: ${y} } }`;
        box.textContent = snippet + '  (copied)';
        navigator.clipboard?.writeText(snippet).catch(() => {});
      });
    }

    // ---------- mode switch (Journey ↔ Explore / Atlas) ----------
    // Both modes read the same data; the difference is which layers/controls render.
    // Explore hides all journey chrome (route, party, timeline, play controls, card) and
    // turns every place pin into a clickable popover. The whole map is revealed.
    const subEl = document.querySelector<HTMLElement>('.pagehead .sub');
    const modeBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.modeswitch button'));
    const mapBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('#mapswitch button'));
    mapBtns.forEach((b) => b.addEventListener('click', () => setExploreMap(b.dataset.map!)));

    function setMode(m: Mode) {
      mode = m;
      document.body.classList.toggle('mode-explore', m === 'explore');
      modeBtns.forEach((b) => b.classList.toggle('active', b.dataset.mode === m));

      // keep the mode in the URL (shareable / survives reload), without a navigation.
      // Explore is the default, so it owns the bare URL; Journey carries ?mode=journey.
      const u = new URL(location.href);
      if (m === 'journey') u.searchParams.set('mode', 'journey');
      else u.searchParams.delete('mode');
      history.replaceState(null, '', u);

      map.closePopup();
      if (m === 'explore') {
        if (playing) { clearInterval(playing); playing = null; playBtn.textContent = '▶ Play journey'; }
        map.removeLayer(journeyLayer);
        atlasLayer.addTo(map);
        renderExploreMap(); // swaps to exploreMap's base + markers + filter + breadcrumb + fit
      } else {
        map.removeLayer(atlasLayer);
        setBase(meta); // journey is world-only — restore the world image if we were in a region
        journeyLayer.addTo(map);
        if (subEl)
          subEl.textContent =
            `E00 – E${maxEpisode} · drag the timeline, click any stop, or step through the journey`;
        render(); // restore journey marker/route/party state (repositions party at world W/H)
        updateCalibrateLink();
        // the pane show/hide resized the map container — recompute, then re-fit
        requestAnimationFrame(frameBase);
      }
    }
    modeBtns.forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode as Mode)));

    // ---------- atlas index pane (Explore) ----------
    const atlasPane = document.getElementById('atlas-pane')!;
    // On phones the pane is a bottom sheet (CSS) that would otherwise cover the map
    // on load, so it starts collapsed (.atlas-hidden) below 768px. The desktop pane is
    // a docked column and stays open by default. `setAtlasHidden` keeps the map sized
    // when the sheet opens/closes — invalidateSize() after the slide so Leaflet doesn't
    // leave the canvas at the smaller (sheet-overlapped) dimensions.
    const sheetMq = window.matchMedia('(max-width: 768px)');
    function setAtlasHidden(hidden: boolean) {
      document.body.classList.toggle('atlas-hidden', hidden);
      // The sheet is `position: fixed` over the map (mobile) so the map size never
      // actually changes, but re-asserting size is cheap and avoids any drift.
      requestAnimationFrame(() => map.invalidateSize());
    }
    document.getElementById('atlas-close')?.addEventListener('click', () => setAtlasHidden(true));
    document.getElementById('atlas-reopen')?.addEventListener('click', () => setAtlasHidden(false));
    // Tapping the sheet backdrop (the ::before pseudo can't be a target, so the sheet
    // itself ignores taps outside the panel via a transparent overlay element).
    document.getElementById('atlas-backdrop')?.addEventListener('click', () => setAtlasHidden(true));
    // Collapse-by-default on phones; re-collapse whenever we cross down into sheet width
    // (avoid a sheet stuck open over the map after a rotate/resize). Desktop is untouched.
    if (sheetMq.matches) document.body.classList.add('atlas-hidden');
    sheetMq.addEventListener('change', (e) => {
      if (e.matches) {
        document.body.classList.add('atlas-hidden');
        // Journey is disabled on phones (toggle hidden in CSS) — if we shrank into
        // phone width while in Journey, drop back to Explore so the user isn't stuck.
        if (mode === 'journey') setMode('explore');
      }
    });

    // a row focuses its marker (+ popup); hovering a row highlights the pin
    atlasPane.querySelectorAll<HTMLElement>('.atlas-row').forEach((row) => {
      const key = row.dataset.key!;
      row.querySelector('.row-focus')?.addEventListener('click', () => {
        focusEntry(key);
        atlasPane.querySelectorAll('.atlas-row.active').forEach((r) => r.classList.remove('active'));
        row.classList.add('active');
        // On the phone sheet, focusing a place should reveal the map it just centred on.
        if (sheetMq.matches) setAtlasHidden(true);
      });
      row.addEventListener('mouseenter', () =>
        atlasMarkers.get(key)?.getElement()?.classList.add('ax-hi'),
      );
      row.addEventListener('mouseleave', () =>
        atlasMarkers.get(key)?.getElement()?.classList.remove('ax-hi'),
      );
    });

    // collapsible groups (clicking the kingdom name still navigates)
    atlasPane.querySelectorAll<HTMLElement>('.grp-head').forEach((head) => {
      const toggle = () => {
        const sec = head.closest('.atlas-group')!;
        const collapsed = sec.classList.toggle('collapsed');
        head.setAttribute('aria-expanded', String(!collapsed));
      };
      head.addEventListener('click', toggle);
      head.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
      });
      head.querySelector('.grp-name')?.addEventListener('click', (e) => e.stopPropagation());
    });

    // filter the index live: text search AND any active slicer chips (Articles /
    // Visited / Unpinned). Hide groups with no surviving rows; update the header count.
    const search = document.getElementById('atlas-search') as HTMLInputElement | null;
    const slicerBtns = Array.from(atlasPane.querySelectorAll<HTMLButtonElement>('.slicer'));
    const countEl = atlasPane.querySelector<HTMLElement>('.atlas-count');
    const emptyEl = document.getElementById('atlas-empty');
    const countDefault = countEl?.textContent ?? '';

    function applyFilter() {
      const q = (search?.value ?? '').trim().toLowerCase();
      const want = new Set(slicerBtns.filter((b) => b.classList.contains('active')).map((b) => b.dataset.slice));
      const filtering = !!q || want.size > 0 || !!activeGroup;
      let total = 0;
      atlasPane.querySelectorAll<HTMLElement>('.atlas-group').forEach((sec) => {
        // When drilled into a region, the index cross-filters to that region's group only.
        if (activeGroup && sec.dataset.group !== activeGroup) {
          sec.style.display = 'none';
          return;
        }
        let shown = 0;
        sec.querySelectorAll<HTMLElement>('.atlas-row').forEach((row) => {
          const d = row.dataset;
          let hit = !q || d.name!.includes(q);
          if (hit && want.has('articles')) hit = d.article === '1';
          if (hit && want.has('visited')) hit = d.visited === '1';
          if (hit && want.has('unpinned')) hit = d.placed === '0';
          row.style.display = hit ? '' : 'none';
          if (hit) shown++;
        });
        sec.style.display = shown ? '' : 'none';
        if (filtering) sec.classList.remove('collapsed'); // open matches while filtering
        total += shown;
      });
      if (emptyEl) emptyEl.hidden = total > 0;
      if (countEl) countEl.textContent = filtering ? `${total} of ${atlas.total} shown` : countDefault;
    }

    search?.addEventListener('input', applyFilter);
    slicerBtns.forEach((b) =>
      b.addEventListener('click', () => { b.classList.toggle('active'); applyFilter(); }),
    );

    // start at the latest stop, then apply the initial mode (default Explore).
    // Journey is disabled on phones, so force Explore there even if ?mode=journey.
    goToStop(stops.length - 1);
    if (sheetMq.matches) mode = 'explore';
    setMode(mode);

    // Deep-link from a location article: /map?place=<slug> focuses that place
    // (key === location slug for dossier entries). Run after setMode so the
    // Explore layer + markers exist for focusEntry to open and pan to.
    const placeParam = params.get('place');
    if (placeParam) requestAnimationFrame(() => focusEntry(placeParam));
  </script>

  <style is:global>
    /* ===== page chrome ===== */
    .pagehead {
      display: flex; align-items: center; gap: 1.4rem;
      padding: 0.9rem 2rem; flex-shrink: 0;
    }
    .pagehead h1 {
      font-family: 'Cormorant Garamond', serif; font-weight: 600;
      font-size: 1.7rem; margin: 0; line-height: 1.1;
    }
    .pagehead .sub { color: var(--muted); font-size: 0.82rem; }
    .controls { margin-left: auto; display: flex; gap: 0.5rem; align-items: center; }
    .btn {
      border: 1px solid var(--hairline); background: var(--bg); border-radius: 8px;
      padding: 0.45rem 0.9rem; font: inherit; font-size: 0.82rem; font-weight: 500;
      color: var(--text); cursor: pointer; transition: border-color 0.15s;
    }
    .btn:hover { border-color: var(--gold-soft); }
    .btn.play { background: var(--gold); border-color: var(--gold); color: #fff; min-width: 120px; }
    /* Live journey readout — a floating pill in the map's open bottom-right corner
       (journey-only). The episode is a purple hotlink to its recap. */
    .readout {
      position: absolute; bottom: 0.9rem; right: 1rem; z-index: 500; display: none;
      font-size: 0.72rem; color: var(--muted);
      background: var(--panel-bg); border: 1px solid var(--hairline);
      border-radius: 10px; padding: 0.4rem 0.85rem; backdrop-filter: blur(8px);
    }
    body:not(.mode-explore) .readout { display: block; }
    .readout b { color: var(--text); font-weight: 600; }
    .readout a { color: var(--link); font-weight: 700; }
    .readout a:hover { color: var(--link-hover); text-decoration: underline; }
    /* Journey nav (topbar, journey-only) — hidden in Explore so the region switcher owns
       that slot left of the mode toggle. */
    .journey-nav { display: flex; gap: 0.5rem; align-items: center; }
    body.mode-explore .journey-nav { display: none; }

    /* Journey ↔ Explore segmented toggle (always visible in both modes). */
    .modeswitch { display: inline-flex; border: 1px solid var(--hairline); border-radius: 8px; overflow: hidden; }
    .modeswitch button {
      font: inherit; font-size: 0.8rem; font-weight: 500; padding: 0.45rem 0.95rem;
      border: 0; background: var(--bg); color: var(--muted); cursor: pointer;
      transition: background 0.15s, color 0.15s;
    }
    .modeswitch button + button { border-left: 1px solid var(--hairline); }
    .modeswitch button:hover { color: var(--text); }
    .modeswitch button.active { background: var(--gold); color: #fff; }

    /* Region drill-in switcher (3c) — World + each regional map. Explore-only. */
    .mapswitch { display: inline-flex; flex-wrap: wrap; border: 1px solid var(--hairline); border-radius: 8px; overflow: hidden; }
    .mapswitch button {
      font: inherit; font-size: 0.78rem; font-weight: 500; padding: 0.45rem 0.8rem;
      border: 0; background: var(--bg); color: var(--muted); cursor: pointer;
      transition: background 0.15s, color 0.15s;
    }
    .mapswitch button + button { border-left: 1px solid var(--hairline); }
    .mapswitch button:hover { color: var(--text); }
    .mapswitch button.active { background: var(--gold); color: #fff; }
    /* Region switching only makes sense in Explore; Journey is world-only. */
    body:not(.mode-explore) #mapswitch { display: none; }

    /* ===== map + card ===== */
    .main { flex: 1; display: flex; min-height: 0; border-top: 1px solid var(--hairline); position: relative; }
    .mapwrap { flex: 1; position: relative; min-width: 0; }
    #map { position: absolute; inset: 0; }
    /* Off-map surround — the empty area *around* the world image (Leaflet leaves a flat
       rectangle when the sheet is fitted/zoomed out). We never touch the image itself;
       this only dresses the void so it reads as deep atmospheric sea, not dead canvas.
       A deep sea-slate base + a soft corner vignette gives it depth; a glow + drop shadow
       on the image layer (below) lifts the map sheet off it so the rectangle seam reads
       as an intentional edge rather than a hard cut. */
    /* Scoped under .mapwrap so this beats Leaflet's own `.leaflet-container { background:#ddd }`
       (equal specificity otherwise, and Vite injects leaflet.css after this block → it'd win). */
    .mapwrap .leaflet-container {
      background-color: #8b9aa0;
      background-image:
        /* subtle cool highlight near top so the surround isn't a flat slab */
        radial-gradient(ellipse 85% 75% at 50% 10%, rgba(214, 226, 229, 0.40), transparent 58%),
        /* broad vignette → deep sea-ink, darkening the field toward every edge so the
           void reads as deep water even where the map sits off-centre */
        radial-gradient(ellipse 120% 120% at 50% 46%, transparent 30%, rgba(33, 46, 54, 0.78) 100%);
      background-size: cover, cover;
      background-repeat: no-repeat, no-repeat;
      font: inherit;
    }
    /* Lift the map sheet off the surround: a soft halo feathers the seam, a drop shadow
       gives depth, and a hairline rim keeps the sheet edge crisp and intentional. */
    .leaflet-image-layer {
      box-shadow:
        0 0 0 1px rgba(28, 38, 44, 0.22),
        0 6px 30px rgba(24, 34, 40, 0.42),
        0 0 64px 14px rgba(20, 30, 36, 0.30);
    }
    /* Dark mode: the lit map sheet floats on deep sea-ink, vignetting to near-black. */
    :root[data-theme='dark'] .mapwrap .leaflet-container {
      background-color: #10161a;
      background-image:
        radial-gradient(ellipse 90% 80% at 50% 12%, rgba(58, 78, 88, 0.20), transparent 62%),
        radial-gradient(ellipse 130% 130% at 50% 48%, transparent 38%, rgba(0, 0, 0, 0.66) 100%);
      background-size: cover, cover;
      background-repeat: no-repeat, no-repeat;
    }
    :root[data-theme='dark'] .leaflet-image-layer {
      box-shadow:
        0 0 0 1px rgba(0, 0, 0, 0.5),
        0 6px 34px rgba(0, 0, 0, 0.66),
        0 0 70px 16px rgba(0, 0, 0, 0.5);
    }
    :root[data-theme='dark'] .leaflet-bar a {
      background: var(--surface); color: var(--text); border-bottom-color: var(--hairline);
    }
    :root[data-theme='dark'] .leaflet-bar a:hover { background: var(--hairline); }

    /* Calibration affordance — a header link (off the map canvas, so the zoom buttons
       never clip it). Subtle by default, gold on hover. */
    .calibrate-link {
      display: inline-block; margin-top: 0.3rem;
      font-size: 0.7rem; font-weight: 500; color: var(--muted);
      text-decoration: none; border-bottom: 1px dotted var(--hairline);
    }
    .pagehead .sub { display: block; } /* keep the calibrate link on its own line below */
    .calibrate-link:hover { color: var(--gold); border-bottom-color: var(--gold-soft); }
    .maplegend {
      position: absolute; bottom: 0.9rem; left: 1rem; z-index: 500;
      font-size: 0.7rem; color: var(--muted);
      background: var(--panel-bg); border: 1px solid var(--hairline);
      border-radius: 10px; padding: 0.55rem 0.85rem; display: grid; gap: 0.3rem;
    }
    .maplegend .row { display: flex; align-items: center; gap: 0.55rem; }
    .maplegend .sw { width: 26px; height: 0; border-top: 2px solid; flex-shrink: 0; }
    .maplegend .sw-traveled { border-color: var(--route); border-top-width: 2.6px; }
    .maplegend .sw-ahead { border-top-style: dotted; border-color: rgba(106, 51, 176, 0.6); }
    .maplegend .sw-planar { border-top-style: dashed; border-color: var(--route); }
    .calibrate-readout {
      position: absolute; top: 0.9rem; left: 50%; transform: translateX(-50%); z-index: 600;
      font-family: ui-monospace, Menlo, monospace; font-size: 0.78rem; color: var(--text);
      background: var(--surface); border: 1px solid var(--gold-soft); border-radius: 8px; padding: 0.4rem 0.8rem;
    }

    /* ===== SVG overlay element styles (legs) ===== */
    /* Transition only paint props — NEVER geometry, or Leaflet's per-zoom point
       recompute gets animated and the lines lag-then-jump on zoom. */
    /* Route is texair-purple, not gold — gold washed out against the green/tan landmass. */
    .leg { stroke: rgba(106, 51, 176, 0.55); stroke-width: 2; stroke-dasharray: 1 7; stroke-linecap: round; opacity: 0.85; transition: stroke 0.4s, stroke-width 0.4s, opacity 0.4s, stroke-dasharray 0.4s; fill: none; }
    .leg.planar { stroke-dasharray: 1 9; opacity: 0.6; }
    .leg.traveled { stroke: var(--route); stroke-dasharray: none; stroke-width: 2.6; opacity: 1; }
    .leg.traveled.planar { stroke-dasharray: 5 5; }

    /* ===== markers ===== */
    .mk-wrap { overflow: visible; }
    .mk-dot {
      position: absolute; left: -5px; top: -5px; width: 10px; height: 10px; border-radius: 50%;
      background: var(--bg); border: 1.5px solid var(--muted);
      transition: background 0.2s, border-color 0.2s, border-width 0.2s; cursor: pointer;
    }
    .mk-wrap:hover .mk-dot { border-color: var(--route); border-width: 2.5px; }
    .mk-dot.planar { transform: rotate(45deg); border-radius: 2px; }
    .mk-label {
      position: absolute; left: 9px; top: -8px; white-space: nowrap;
      font-size: 11px; font-weight: 500; color: var(--muted);
      text-shadow: 0 0 3px var(--bg), 0 0 3px var(--bg), 0 0 3px var(--bg); pointer-events: none;
    }
    .mk-wrap.visited .mk-dot { background: var(--route-soft); border-color: var(--route); }
    .mk-wrap.here .mk-dot { background: var(--route); border-color: var(--route); }
    .mk-wrap.here .mk-label { color: var(--text); font-weight: 600; }

    .party-wrap { overflow: visible; }
    .party-diamond {
      position: absolute; left: -6px; top: -6px; width: 12px; height: 12px;
      background: var(--route); border: 1.5px solid #fff; transform: rotate(45deg);
      box-shadow: 0 1px 4px rgba(35, 33, 28, 0.45);
    }
    .party-pulse {
      position: absolute; left: -7px; top: -7px; width: 14px; height: 14px; border-radius: 50%;
      border: 1.5px solid var(--route); animation: party-pulse 2s ease-out infinite;
    }
    @keyframes party-pulse {
      0% { transform: scale(0.5); opacity: 0.7; }
      100% { transform: scale(2.6); opacity: 0; }
    }
    /* One-shot ripple when a place marker is selected — reuses the party-pulse
       keyframe, run once on the shared timing tokens. */
    .mk-ripple {
      position: absolute; left: -7px; top: -7px; width: 14px; height: 14px; border-radius: 50%;
      border: 1.5px solid var(--route); pointer-events: none;
      animation: party-pulse var(--dur-panel) var(--ease-out) 1 forwards;
    }

    /* ===== story card ===== */
    .card {
      width: 350px; flex-shrink: 0; border-left: 1px solid var(--hairline);
      background: var(--bg); padding: 1.5rem 1.6rem; overflow-y: auto;
      display: flex; flex-direction: column;
    }
    .card .kicker {
      font-size: 0.68rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--gold); margin-bottom: 0.5rem;
    }
    .card h2 {
      font-family: 'Cormorant Garamond', serif; font-weight: 600; font-size: 1.7rem;
      line-height: 1.12; margin: 0 0 0.7rem;
    }
    .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1rem; }
    .chip {
      font-size: 0.7rem; font-weight: 600; border: 1px solid var(--hairline); border-radius: 99px;
      padding: 0.2rem 0.65rem; color: var(--muted); background: var(--surface);
    }
    .chip.plane { border-color: var(--gold-soft); color: var(--link); text-transform: capitalize; }
    .card .blurb { font-size: 0.92rem; line-height: 1.6; color: var(--ink-soft); margin-bottom: 1.1rem; }
    .card h5 {
      font-size: 0.68rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--muted); margin: 0 0 0.5rem;
    }
    .beats { list-style: none; padding: 0; margin: 0 0 1.2rem; }
    .beats li {
      font-size: 0.85rem; line-height: 1.5; color: var(--ink-soft); padding-left: 1.05rem;
      position: relative; margin-bottom: 0.45rem;
    }
    .beats li::before {
      content: ''; position: absolute; left: 0; top: 0.5em; width: 5px; height: 5px;
      background: var(--gold-soft); transform: rotate(45deg);
    }
    .stop-dots { display: flex; gap: 0.28rem; flex-wrap: wrap; margin-bottom: 1.2rem; }
    .stop-dots span {
      width: 8px; height: 8px; border-radius: 50%; background: var(--hairline);
      cursor: pointer; transition: background 0.2s;
    }
    .stop-dots span.done { background: var(--gold-soft); }
    .stop-dots span.now { background: var(--gold); outline: 2px solid var(--gold-soft); outline-offset: 1.5px; }
    .card .links {
      margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--hairline);
      display: flex; gap: 0.6rem; flex-wrap: wrap;
    }
    .card .links a {
      font-size: 0.78rem; font-weight: 500; border: 1px solid var(--hairline);
      border-radius: 8px; padding: 0.35rem 0.75rem;
    }
    .card .links a:hover { border-color: var(--gold-soft); text-decoration: none; }

    /* ===== timeline scrubber (3b) ===== */
    .timeline {
      flex-shrink: 0; border-top: 1px solid var(--hairline); background: var(--bg);
      padding: 0.9rem 2rem 1rem; user-select: none;
      /* Entering Journey toggles this from display:none → shown, which restarts the
         animation, so the dock slides up instead of snapping in. (One-shot per entry.) */
      animation: tl-in var(--dur-panel) var(--ease-out);
    }
    @keyframes tl-in {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @media (prefers-reduced-motion: reduce) { .timeline { animation: none; } }
    .tl-top {
      display: flex; justify-content: space-between;
      font-size: 0.68rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--muted); margin-bottom: 0.55rem;
    }
    .track { position: relative; height: 44px; cursor: pointer; touch-action: none; }
    .arcs {
      position: absolute; left: 0; right: 0; top: 18px; height: 10px;
      display: flex; border-radius: 99px; overflow: hidden;
    }
    .arcband { height: 100%; opacity: 0.35; transition: opacity 0.2s; }
    .arcband:hover, .arcband.on { opacity: 0.85; }
    .tick {
      position: absolute; top: 16px; width: 9px; height: 9px;
      background: var(--bg); border: 1.5px solid var(--muted);
      transform: translateX(-50%) rotate(45deg); margin-top: 1.5px;
      cursor: pointer; z-index: 2; transition: background 0.15s, border-color 0.15s;
    }
    .tick:hover { border-color: var(--route); background: var(--route-soft); }
    .tick.done { background: var(--route-soft); border-color: var(--route); }
    .playhead {
      position: absolute; top: 5px; z-index: 3; transform: translateX(-50%);
      pointer-events: none; text-align: center; transition: left 0.15s linear;
    }
    .playhead .head {
      width: 15px; height: 15px; background: var(--route); border: 2px solid #fff;
      box-shadow: 0 1px 5px rgba(35, 33, 28, 0.4); transform: rotate(45deg); margin: 0 auto;
    }
    .playhead .stem { width: 1.5px; height: 14px; background: var(--route); margin: -2px auto 0; }
    .arc-labels { position: relative; height: 14px; margin-top: 0.35rem; font-size: 0.62rem; color: var(--muted); }
    .arc-labels span { position: absolute; transform: translateX(-50%); white-space: nowrap; letter-spacing: 0.04em; }

    /* ===== Explore / Atlas mode ===== */
    /* Hide every journey-only layer + control; the map fills the freed space. */
    body.mode-explore .timeline,
    body.mode-explore .maplegend,
    body.mode-explore .card { display: none; }
    /* Hide the route legs (SVG) WITHOUT hiding the image overlay — Leaflet puts both
       the polylines and the imageOverlay <img> in .leaflet-overlay-pane, so target the
       svg only or the whole map image disappears. */
    body.mode-explore .leaflet-overlay-pane svg,
    body.mode-explore .party-wrap { display: none; }
    /* All pins read as uniformly "available" (journey here/visited classes are removed in JS). */
    body.mode-explore .mk-dot { background: var(--route-soft); border-color: var(--route); }
    body.mode-explore .mk-label { color: var(--ink-soft); }

    /* Explore popover — themed override of Leaflet's default white bubble. */
    .xpop .leaflet-popup-content-wrapper {
      background: var(--surface); color: var(--text);
      border: 1px solid var(--hairline); border-radius: 12px;
      box-shadow: 0 8px 30px rgba(35, 33, 28, 0.22);
      overflow: hidden; /* clip the rounded corners + any stray horizontal spill */
    }
    .xpop .leaflet-popup-tip { background: var(--surface); border: 1px solid var(--hairline); }
    .xpop .leaflet-popup-content { margin: 0.85rem 1rem; font: inherit; }
    /* When maxHeight kicks in Leaflet wraps the body in .leaflet-popup-scrolled. */
    .xpop .leaflet-popup-scrolled { overflow-y: auto; overflow-x: hidden; }
    .xp { max-width: 100%; }
    .xp * { max-width: 100%; box-sizing: border-box; }
    .xpop .leaflet-popup-close-button { color: var(--muted); }
    .xp h3 {
      font-family: 'Cormorant Garamond', serif; font-weight: 600; font-size: 1.3rem;
      line-height: 1.1; margin: 0 0 0.25rem; color: var(--text);
    }
    .xp-eps {
      font-size: 0.66rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--muted); margin-bottom: 0.5rem;
    }
    .xp-plane {
      display: inline-block; font-size: 0.62rem; font-weight: 600; text-transform: capitalize;
      color: var(--link); border: 1px solid var(--gold-soft); border-radius: 99px;
      padding: 0.05rem 0.55rem; margin-bottom: 0.4rem;
    }
    .xp p { font-size: 0.85rem; line-height: 1.5; color: var(--ink-soft); margin: 0 0 0.6rem; }
    .xp a { font-size: 0.78rem; font-weight: 600; color: var(--link); }
    .xp a:hover { text-decoration: underline; }
    /* Atlas popover extras: thumbnail, kind line, approximate-location flag. */
    .xp.atlas .xp-kind {
      font-size: 0.62rem; font-weight: 600; letter-spacing: 0.1em; text-transform: capitalize;
      color: var(--muted); margin-bottom: 0.2rem;
    }
    .xp-thumb {
      width: 100%; max-height: 140px; object-fit: cover; border-radius: 8px;
      margin-bottom: 0.55rem; display: block; border: 1px solid var(--hairline);
    }
    .xp-flag {
      font-size: 0.68rem; color: var(--muted); font-style: italic;
      border-left: 2px solid var(--gold-soft); padding-left: 0.5rem; margin: 0 0 0.55rem;
    }

    /* ===== Explore atlas: pins ===== */
    .ax-wrap { overflow: visible; }
    .ax-dot {
      position: absolute; left: -5px; top: -5px; width: 10px; height: 10px; border-radius: 50%;
      background: var(--route); border: 1.5px solid #fff;
      box-shadow: 0 1px 3px rgba(35, 33, 28, 0.4); cursor: pointer;
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .ax-dot.faction { border-radius: 2px; background: var(--gold); }
    .ax-dot.planar { transform: rotate(45deg); border-radius: 2px; }
    /* Not-yet-pinned places recede as a small hollow ring — a quiet "calibrate me"
       state that lets the 17 real pins read as the bold, authoritative ones. */
    .ax-dot.unplaced {
      width: 8px; height: 8px; left: -4px; top: -4px;
      background: transparent; border: 1.5px solid var(--route); opacity: 0.5; box-shadow: none;
    }
    .ax-wrap:hover .ax-dot, .ax-wrap.ax-hi .ax-dot { transform: scale(1.5); box-shadow: 0 2px 8px rgba(35, 33, 28, 0.5); }
    .ax-wrap:hover .ax-dot.unplaced, .ax-wrap.ax-hi .ax-dot.unplaced { opacity: 1; background: var(--route); border-color: #fff; }
    .ax-wrap:hover .ax-dot.planar, .ax-wrap.ax-hi .ax-dot.planar { transform: rotate(45deg) scale(1.5); }
    .ax-label {
      position: absolute; left: 10px; top: -8px; white-space: nowrap;
      font-size: 11px; font-weight: 600; color: var(--text);
      text-shadow: 0 0 3px var(--bg), 0 0 3px var(--bg), 0 0 4px var(--bg);
      pointer-events: none; opacity: 0; transition: opacity 0.12s;
    }
    .ax-wrap:hover .ax-label, .ax-wrap.ax-hi .ax-label { opacity: 1; }

    /* Explore legend (shown only in Explore; the journey legend is hidden there). */
    .atlas-legend {
      position: absolute; bottom: 0.9rem; left: 1rem; z-index: 500;
      font-size: 0.7rem; color: var(--muted);
      background: var(--panel-bg); border: 1px solid var(--hairline);
      border-radius: 10px; padding: 0.55rem 0.85rem; display: none; gap: 0.3rem;
    }
    body.mode-explore .atlas-legend { display: grid; }
    .atlas-legend .row { display: flex; align-items: center; gap: 0.55rem; }
    .atlas-legend .lg-dot {
      width: 10px; height: 10px; border-radius: 50%; background: var(--route);
      border: 1.5px solid #fff; flex-shrink: 0;
    }
    .atlas-legend .lg-dot.unplaced { background: var(--bg); border: 1.5px dashed var(--route); }
    .atlas-legend .lg-dot.planar { transform: rotate(45deg); border-radius: 2px; }
    .atlas-legend .lg-dot.faction { border-radius: 2px; background: var(--gold); }

    /* ===== Explore atlas: index pane (right) ===== */
    .atlas {
      width: 340px; flex-shrink: 0; border-left: 1px solid var(--hairline);
      background: var(--bg); display: none; flex-direction: column; min-height: 0;
    }
    body.mode-explore:not(.atlas-hidden) .atlas { display: flex; }
    .atlas-head {
      display: flex; align-items: flex-start; justify-content: space-between;
      padding: 1.1rem 1.3rem 0.7rem; gap: 0.5rem; flex-shrink: 0;
    }
    .atlas-head h2 {
      font-family: 'Cormorant Garamond', serif; font-weight: 600; font-size: 1.5rem;
      line-height: 1; margin: 0;
    }
    .atlas-count {
      display: block; margin-top: 0.25rem; font-size: 0.66rem; font-weight: 600;
      letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted);
    }
    .atlas-close {
      border: 1px solid var(--hairline); background: var(--bg); color: var(--muted);
      border-radius: 8px; width: 30px; height: 30px; font-size: 1.15rem; line-height: 1;
      cursor: pointer; flex-shrink: 0; transition: border-color 0.15s, color 0.15s;
    }
    .atlas-close:hover { border-color: var(--route); color: var(--text); }
    .atlas-filter { padding: 0 1.3rem 0.7rem; flex-shrink: 0; }
    .atlas-filter input {
      width: 100%; box-sizing: border-box; font: inherit; font-size: 0.82rem;
      padding: 0.45rem 0.7rem; border: 1px solid var(--hairline); border-radius: 8px;
      background: var(--surface); color: var(--text);
    }
    .atlas-filter input:focus { outline: none; border-color: var(--route); }
    .atlas-slicers { display: flex; gap: 0.4rem; padding: 0 1.3rem 0.7rem; flex-shrink: 0; }
    .slicer {
      font: inherit; font-size: 0.72rem; font-weight: 600; cursor: pointer;
      padding: 0.28rem 0.6rem; border-radius: 99px;
      border: 1px solid var(--hairline); background: var(--bg); color: var(--muted);
      transition: border-color 0.15s, color 0.15s, background 0.15s;
    }
    .slicer:hover { border-color: var(--gold-soft); color: var(--text); }
    .slicer.active { background: var(--gold); border-color: var(--gold); color: #fff; }
    .atlas-empty {
      padding: 0.4rem 1.3rem 0.8rem; font-size: 0.8rem; color: var(--muted); font-style: italic;
    }
    .atlas-groups { flex: 1; overflow-y: auto; padding: 0 0.6rem 1rem; }

    .atlas-group { margin-bottom: 0.15rem; }
    .grp-head {
      display: flex; align-items: center; gap: 0.45rem; cursor: pointer; user-select: none;
      padding: 0.5rem 0.7rem; border-radius: 8px;
      position: sticky; top: 0; background: var(--bg); z-index: 1;
    }
    .grp-head:hover { background: var(--surface); }
    /* Clear accordion affordance: a bordered −/+ box (− open, + collapsed). */
    .grp-toggle {
      flex-shrink: 0; width: 19px; height: 19px; border: 1px solid var(--hairline);
      border-radius: 5px; display: inline-flex; align-items: center; justify-content: center;
      font-size: 1rem; font-weight: 600; line-height: 1; color: var(--muted);
      transition: border-color 0.15s, color 0.15s, background 0.15s;
    }
    .grp-toggle::before { content: '\2212'; } /* − */
    .atlas-group.collapsed .grp-toggle::before { content: '+'; }
    .grp-head:hover .grp-toggle { border-color: var(--route); color: var(--route); background: var(--bg); }
    .grp-name {
      font-size: 0.78rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
      color: var(--text); margin-right: auto;
    }
    a.grp-name:hover { color: var(--link); text-decoration: underline; }
    .grp-count {
      font-size: 0.64rem; font-weight: 600; color: var(--muted);
      background: var(--surface); border: 1px solid var(--hairline);
      border-radius: 99px; padding: 0.05rem 0.5rem;
    }
    .grp-list { list-style: none; margin: 0 0 0.4rem; padding: 0; }
    .atlas-group.collapsed .grp-list { display: none; }

    .atlas-row { display: flex; align-items: center; }
    .row-focus {
      flex: 1; display: flex; align-items: center; gap: 0.4rem; min-width: 0;
      border: 0; background: none; font: inherit; text-align: left; cursor: pointer;
      padding: 0.3rem 0.5rem; border-radius: 7px; color: var(--ink-soft);
    }
    .row-focus:hover { background: var(--surface); }
    .atlas-row.active .row-focus { background: var(--gold-soft); }
    .row-thumb {
      width: 26px; height: 26px; flex-shrink: 0; border-radius: 5px; object-fit: cover;
      border: 1px solid var(--hairline);
    }
    .row-dot {
      width: 10px; height: 10px; flex-shrink: 0; margin: 0 8px; border-radius: 50%;
      background: var(--route); border: 1.5px solid var(--bg);
    }
    .row-dot.faction { border-radius: 2px; background: var(--gold); }
    .row-dot.planar { transform: rotate(45deg); border-radius: 2px; }
    .row-dot.unplaced { background: transparent; border: 1.5px solid var(--muted); opacity: 0.7; }
    .row-name { font-size: 0.85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .row-flag { font-size: 0.85rem; color: var(--muted); margin-left: 0.25rem; flex-shrink: 0; }
    .row-link {
      flex-shrink: 0; font-size: 0.9rem; color: var(--muted); padding: 0 0.5rem;
      text-decoration: none; line-height: 1;
    }
    .row-link:hover { color: var(--link); }

    /* Reopen tab — only in Explore once the pane is closed. */
    .atlas-reopen {
      display: none; position: absolute; top: 0.9rem; right: 1rem; z-index: 600;
      border: 1px solid var(--hairline); background: var(--panel-bg); color: var(--text);
      border-radius: 99px; padding: 0.4rem 0.9rem; font: inherit; font-size: 0.78rem;
      font-weight: 600; cursor: pointer; align-items: center; gap: 0.4rem;
    }
    .atlas-reopen:hover { border-color: var(--route); }
    body.mode-explore.atlas-hidden .atlas-reopen { display: inline-flex; }

    /* Phone-only backdrop element — inert/transparent at desktop widths (the atlas is a
       docked column there). It becomes a tap-to-dismiss scrim under the bottom sheet
       at ≤768px (see the phone block below). */
    .atlas-backdrop { display: none; }

    @media (max-width: 900px) {
      .main { flex-direction: column; }
      /* The journey story card still stacks below the map (journey-only; the atlas gets
         its own bottom-sheet treatment ≤768 below). */
      .card { width: auto; border-left: 0; border-top: 1px solid var(--hairline); max-height: 45vh; }
      .atlas { width: auto; border-left: 0; border-top: 1px solid var(--hairline); max-height: 50vh; }
      .pagehead { flex-wrap: wrap; }
      .controls { margin-left: 0; }
      .timeline { padding: 0.8rem 1rem 0.9rem; }
      .arc-labels { display: none; } /* labels overlap on narrow widths */
    }

    /* ===== Phone map layout (≤768 "collapse → phone") =====
       The map page is a full-height flex column (header / .main / timeline). At phone
       width the desktop side-by-side map+index doesn't fit, the header controls overflow,
       and the docked atlas covers the map. Fixes, all gated here so desktop is untouched:
        · header collapses to a single tidy block (title small, sub + calibrate readable);
        · legend/region/mode chips wrap instead of clipping off the right edge;
        · the atlas becomes a collapsed-by-default bottom sheet (JS adds .atlas-hidden on
          load ≤768) so the map is visible immediately, reopened via the ☰ Atlas pill. */
    @media (max-width: 768px) {
      /* --- header → single compact block --- */
      .pagehead {
        padding: 0.7rem 1rem 0.6rem;
        gap: 0.5rem;
        align-items: flex-start;
      }
      .pagehead h1 { font-size: 1.3rem; }
      .pagehead .sub { font-size: 0.76rem; }
      /* Controls drop to their own full-width row and wrap; nothing clips off-edge. */
      .controls {
        margin-left: 0;
        width: 100%;
        flex-wrap: wrap;
        gap: 0.4rem;
      }
      .mapswitch, .journey-nav { flex-wrap: wrap; }
      /* Journey mode doesn't work well on a phone (the drag-timeline + story card
         need pointer precision and width), so it's disabled here: the Explore/Journey
         toggle is hidden and the page is forced into Explore (see setMode guard in the
         script). With it gone, the region switcher is the only control row — which also
         removes the height-mismatch between the two segmented switches. */
      .modeswitch { display: none; }
      .mapswitch button {
        padding: 0.5rem 0.85rem; /* ≥44px tall tap target */
        white-space: nowrap;
      }
      .journey-nav .btn { padding: 0.5rem 0.8rem; }

      /* --- atlas → bottom sheet, collapsed by default (JS adds .atlas-hidden ≤768) --- */
      /* When NOT hidden, the sheet floats over the map (fixed) so the map keeps its full
         size underneath — no relayout, no Leaflet resize churn. */
      body.mode-explore .atlas {
        position: fixed;
        left: 0; right: 0; bottom: 0;
        width: auto;
        max-height: 72vh;
        border-left: 0;
        border-top: 1px solid var(--hairline);
        border-top-left-radius: 16px;
        border-top-right-radius: 16px;
        box-shadow: 0 -10px 30px rgba(28, 38, 44, 0.28);
        z-index: 1200;
        transform: translateY(0);
        transition: transform var(--dur-panel) var(--ease-in-out);
      }
      /* Collapsed: slide the sheet fully off the bottom. (Kept display:flex via the
         existing mode-explore rule so the slide animates; pointer-events off while down.) */
      body.mode-explore.atlas-hidden .atlas {
        display: flex;
        transform: translateY(102%);
        pointer-events: none;
        box-shadow: none;
      }
      /* A little grab affordance at the top of the sheet. */
      .atlas-head { position: relative; padding-top: 1rem; }
      .atlas-head::before {
        content: '';
        position: absolute;
        top: 0.4rem; left: 50%; transform: translateX(-50%);
        width: 36px; height: 4px; border-radius: 99px; background: var(--hairline);
      }

      /* Scrim behind the open sheet — tap to dismiss. */
      body.mode-explore:not(.atlas-hidden) .atlas-backdrop {
        display: block;
        position: fixed; inset: 0; z-index: 1100;
        background: rgba(20, 30, 36, 0.32);
        animation: atlas-scrim-in var(--dur-panel) var(--ease-out);
      }
      @keyframes atlas-scrim-in { from { opacity: 0; } to { opacity: 1; } }

      /* Reopen pill — always available in Explore on phones (the ☰ Atlas control), not
         only when previously closed. Bottom-centre, clear of the zoom buttons. ≥44px. */
      body.mode-explore .atlas-reopen {
        display: inline-flex;
        top: auto; right: 50%;
        bottom: 1rem; transform: translateX(50%);
        padding: 0.6rem 1.2rem;
        font-size: 0.82rem;
        box-shadow: 0 4px 16px rgba(28, 38, 44, 0.22);
      }
      /* Hide the pill while the sheet is up (the sheet's × closes it). */
      body.mode-explore:not(.atlas-hidden) .atlas-reopen { display: none; }
      /* Bigger close target on the sheet. */
      .atlas-close { width: 38px; height: 38px; font-size: 1.3rem; }

      /* Index rows: comfortable tap targets. */
      .row-focus { padding: 0.5rem 0.5rem; }
      .row-link { padding: 0 0.7rem; min-width: 44px; text-align: center; }
      .grp-head { padding: 0.6rem 0.7rem; }

      /* On-map legends shrink so they don't crowd the smaller canvas. */
      .maplegend, .atlas-legend { font-size: 0.66rem; padding: 0.45rem 0.65rem; }

      @media (prefers-reduced-motion: reduce) {
        body.mode-explore .atlas { transition: none; }
        body.mode-explore:not(.atlas-hidden) .atlas-backdrop { animation: none; }
      }
    }

    /* ===== Narrow phone polish (≤480) ===== */
    @media (max-width: 480px) {
      .pagehead { padding: 0.6rem 0.85rem 0.5rem; }
      .pagehead h1 { font-size: 1.2rem; }
      /* Region switcher can get long; let it wrap to a tidy second row of pills. */
      .mapswitch button { padding: 0.45rem 0.7rem; font-size: 0.74rem; }
      body.mode-explore .atlas { max-height: 78vh; }
    }
  </style>
</MapLayout>

---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Backlinks from '../../components/Backlinks.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EpisodePager, { type PagerLink } from '../../components/EpisodePager.astro';
import EpisodeRoute from '../../components/EpisodeRoute.astro';
import EpisodeGlance from '../../components/EpisodeGlance.astro';
import GraphView from '../../components/graph/GraphView.tsx';
import EpisodePhotos from '../../components/EpisodePhotos.tsx';
import { getEpisodePhotos } from '../../lib/session-photos';
import { getPublic } from '../../lib/collections';
import { episodeLabel, formatDate } from '../../lib/format';
import { resolveTerm } from '../../lib/match-terms';
import { hrefFor } from '../../lib/links';

export async function getStaticPaths() {
  const entries = await getPublic('episodes');
  return entries.map((entry: any) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as any;
const { Content, headings } = await render(entry);
const d = entry.data;
const heading = episodeLabel(entry.id, d.episode, d.title);

function refList(names: string[]) {
  return names
    .filter((n) => typeof n === 'string')
    .map((n) => ({ name: n, target: resolveTerm(n) }));
}
const locations = refList(d.locations ?? []);
const npcs = refList(d.npcs ?? []);
const photos = getEpisodePhotos(entry.id);

// Sequential pager: order every episode (numeric, -dup2 sessions after their twin),
// find this one, and build prev/next + a ±5 numbered window + jump-by-10 controls.
const PAGER_WINDOW = 5;
const all = (await getPublic('episodes'))
  .slice()
  .sort((a: any, b: any) => (a.data.episode ?? 0) - (b.data.episode ?? 0) || a.id.localeCompare(b.id));
const here = all.findIndex((e: any) => e.id === entry.id);
const toLink = (e: any): PagerLink => ({
  href: `/episodes/${e.id}`,
  num: `E${String(e.data.episode).padStart(2, '0')}${e.id.endsWith('-dup2') ? '·2' : ''}`,
  title: e.data.title ?? undefined,
  current: e.id === entry.id,
});
const at = (i: number): PagerLink | null =>
  i >= 0 && i < all.length ? toLink(all[i]) : null;
const clamp = (i: number) => Math.max(0, Math.min(all.length - 1, i));
const prev = at(here - 1);
const next = at(here + 1);
const jumpBack = here > 0 ? toLink(all[clamp(here - 10)]) : null;
const jumpForward = here < all.length - 1 ? toLink(all[clamp(here + 10)]) : null;
const pagerWindow = all
  .slice(Math.max(0, here - PAGER_WINDOW), Math.min(all.length, here + PAGER_WINDOW + 1))
  .map(toLink);
---

<BaseLayout title={heading} description={`Episode recap — ${d.title}.`} headings={headings}>
  <Breadcrumbs trail={[{ label: 'Wiki', href: '/' }, { label: 'Episodes', href: '/episodes' }, { label: heading }]} />
  <h1>{heading}</h1>

  {
    d.art?.image && (
      <figure class="ep-hero" data-pagefind-ignore>
        <img
          src={d.art.image}
          alt={d.art.scene_title ?? heading}
          width={1024}
          height={683}
          loading="eager"
        />
        {d.art.scene_title && <figcaption>{d.art.scene_title}</figcaption>}
      </figure>
    )
  }

  <aside class="infobox" slot="rail" data-pagefind-ignore>
    <h2>{`E${String(d.episode).padStart(2, '0')}`}</h2>
    <dl>
      <dt>Date</dt><dd>{formatDate(d.date)}</dd>
      {
        locations.length > 0 && (
          <>
            <dt>Locations</dt>
            <dd>
              {locations.map((l, i) => (
                <>
                  {i > 0 && ', '}
                  {l.target ? <a href={hrefFor(l.target.collection, l.target.slug)}>{l.name}</a> : l.name}
                </>
              ))}
            </dd>
          </>
        )
      }
      {
        npcs.length > 0 && (
          <>
            <dt>NPCs</dt>
            <dd>
              {npcs.map((n, i) => (
                <>
                  {i > 0 && ', '}
                  {n.target ? <a href={hrefFor(n.target.collection, n.target.slug)}>{n.name}</a> : n.name}
                </>
              ))}
            </dd>
          </>
        )
      }
      {d.tags?.length > 0 && (<><dt>Tags</dt><dd>{d.tags.join(', ')}</dd></>)}
    </dl>
  </aside>

  <EpisodeRoute route={d.route ?? []} combat={d.combat} />

  <EpisodeGlance
    date={d.date}
    combat={d.combat}
    deaths={d.deaths}
    characters={d.characters}
    npcs={d.npcs}
    locations={d.locations}
    milestone={d.milestone}
    stops={d.route?.length}
  />

  {/* Authored order (Summary first) is the opposite of reading order, so the
      body is a flex column and `order` promotes the skimmable sections. The
      `.prose` wrapper is display:contents so the markdown sections become flex
      items of this container and can interleave with the recap. */}
  <div class="ep-flow">
    <article class="prose ep-prose">
      <Content />
    </article>
    {
      d.recap && (
        <section class="epsec ep-recap" data-sec="recap">
          <h2>The recap</h2>
          <p>{d.recap}</p>
        </section>
      )
    }
  </div>

  {
    photos.length > 0 && (
      <section class="ep-photos-section" data-pagefind-ignore>
        <h2>Table photos</h2>
        <p class="ep-photos-sub">{photos.length} snapshot{photos.length === 1 ? '' : 's'} from this session · click to enlarge</p>
        <EpisodePhotos client:visible photos={photos} />
      </section>
    )
  }

  <EpisodePager
    prev={prev}
    next={next}
    jumpBack={jumpBack}
    jumpForward={jumpForward}
    window={pagerWindow}
  />

  <section class="localgraph" data-pagefind-ignore>
    <h2>Connections</h2>
    <p class="lg-sub">People, places and things linked to this episode. Click a node to jump · <a href="/graph">full graph →</a></p>
    <div class="graph-hero">
      <GraphView client:only="react" height="440px" fullHref="/graph" localTo={`episodes/${entry.id}`} />
    </div>
  </section>

  <Backlinks collection="episodes" slug={entry.id} />
</BaseLayout>

<style>
  /* Episode scene plate — wide 3:2 reference/header art (Phase-2 AI codex art). */
  .ep-hero {
    margin: 0 0 1.5rem;
  }
  .ep-hero img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid var(--border, rgba(0, 0, 0, 0.12));
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.18);
  }
  .ep-hero figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    font-style: italic;
    text-align: center;
    color: var(--muted, #6b6256);
  }
</style>

<style is:global>
  /* ── Episode body flow (docs/specs/episode-route.md) ──────────────────────
     Sections are wrapped by remark-section-wrap and reordered here. Markdown-
     generated HTML can't be reached by Astro's scoped styles, hence is:global;
     every selector is nested under .ep-flow so nothing leaks to other pages. */
  .ep-flow {
    display: flex;
    flex-direction: column;
  }
  /* Children of .prose become flex items of .ep-flow so the authored `## `
     sections can interleave with the template-rendered recap. */
  .ep-flow .ep-prose { display: contents; }

  /* Default bucket. Attribute selectors below out-specify this, so a section
     type nobody anticipated still lands somewhere sensible. */
  .ep-flow .epsec { order: 7; }
  .ep-flow .epsec[data-sec='key-events'] { order: 1; }
  .ep-flow .epsec[data-sec='loot'] { order: 2; }
  .ep-flow .epsec[data-sec='combat'] { order: 3; }
  .ep-flow .epsec[data-sec='open-threads'] { order: 4; }
  .ep-flow .epsec[data-sec='recap'] { order: 5; }
  .ep-flow .epsec[data-sec='summary'] { order: 6; }
  .ep-flow .epsec[data-sec='notes'] { order: 8; }

  /* ── Collapsible sections ─────────────────────────────────────────────── */
  .ep-flow details.epsec {
    border: 1px solid var(--hairline);
    border-radius: 10px;
    background: var(--surface);
    margin: 0 0 0.6rem;
    overflow: hidden;
  }
  .ep-flow details.epsec > summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 0.95rem;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: var(--text);
    transition: background-color var(--dur-instant) ease;
  }
  .ep-flow details.epsec > summary::-webkit-details-marker { display: none; }
  /* Custom disclosure caret — rotates on open. */
  .ep-flow details.epsec > summary::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    border-right: 1.5px solid var(--gold);
    border-bottom: 1.5px solid var(--gold);
    transform: rotate(-45deg);
    transition: transform var(--dur-state) var(--ease-out);
  }
  .ep-flow details.epsec[open] > summary::before { transform: rotate(45deg); }
  .ep-flow details.epsec > summary:hover { background: var(--bg); }
  .ep-flow .epsec-title {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .ep-flow .epsec-body {
    padding: 0.2rem 0.95rem 0.9rem;
    border-top: 1px solid var(--hairline);
  }
  .ep-flow .epsec-body > :first-child { margin-top: 0.7rem; }
  .ep-flow .epsec-body > :last-child { margin-bottom: 0; }

  /* ── The recap — the one section anyone actually reads ─────────────────── */
  .ep-flow .ep-recap {
    margin: 1.2rem 0 0.4rem;
    padding: 1rem 1.15rem;
    border-left: 3px solid var(--gold);
    background: var(--surface);
    border-radius: 0 10px 10px 0;
  }
  .ep-flow .ep-recap h2 {
    margin: 0 0 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    border: 0;
  }
  .ep-flow .ep-recap p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  /* The dense Summary is a search target, not a read — de-emphasise it. */
  .ep-flow .epsec[data-sec='summary'] { margin-top: 1.6rem; }
</style>

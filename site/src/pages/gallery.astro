---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryView from '../components/gallery/GalleryView.tsx';
---

<BaseLayout
  title="Gallery"
  description="A wall of Alambor artwork — character portraits, factions, items, locations and more. Browse the cascading wall."
  variant="full"
>
  <div class="gallery-host">
    <GalleryView client:only="react" />
  </div>
</BaseLayout>

<style is:global>
  /* The gallery owns the full viewport below the topbar. */
  .gallery-host {
    width: 100%;
    min-height: calc(100vh - var(--topbar-h) - 1px);
  }
</style>

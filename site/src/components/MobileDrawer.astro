---
// Mobile navigation drawer — the nav restored once the sidenav collapses (≤1080px).
// A left slide-in panel + backdrop, opened by the topbar hamburger
// (`[data-drawer-toggle]`, wired by id via `aria-controls`). Renders the module
// links (Wiki/Graph/Map/Gallery) at the top — handy on a narrow screen where the
// topbar's wrapped module row is hidden — and a `nav` slot below for the full
// `Sidebar.astro` tree (reused, not rebuilt). On the map (no Sidebar) the slot is
// empty and only the module links show. Closed by default; opens on the hamburger,
// closes on link tap / backdrop tap / Esc. Focus-trapped + body-scroll-locked while
// open. Honors prefers-reduced-motion (the panel cross-fades instead of sliding).
interface Module {
  key: string;
  label: string;
  href: string;
  soon?: boolean;
}
interface Props {
  modules: Module[];
  isActive?: (key: string) => boolean;
  activeKey?: string;
}
const { modules, isActive, activeKey } = Astro.props as Props;
const active = (key: string) => (isActive ? isActive(key) : key === activeKey);
const hasNav = Astro.slots.has('nav');
---

<div class="drawer-backdrop" data-drawer-backdrop hidden></div>
<aside
  id="mobile-drawer"
  class="drawer"
  data-drawer
  aria-label="Navigation"
  aria-hidden="true"
  hidden
>
  <div class="drawer-head">
    <span class="drawer-title">Navigate</span>
    <button type="button" class="drawer-close" data-drawer-close aria-label="Close navigation menu">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path
          d="M6 6l12 12M18 6L6 18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>
  </div>

  <nav class="drawer-modules" aria-label="Modules">
    {
      modules.map((m) =>
        m.soon ? (
          <span class="drawer-module soon" aria-disabled="true">
            {m.label}
            <em>soon</em>
          </span>
        ) : (
          <a href={m.href} class:list={['drawer-module', { active: active(m.key) }]}>
            {m.label}
          </a>
        ),
      )
    }
  </nav>

  {
    hasNav && (
      <div class="drawer-nav">
        <slot name="nav" />
      </div>
    )
  }
</aside>

<style is:global>
  /* ===== Mobile navigation drawer ===== */
  /* The drawer + backdrop live in the layout flow but are inert (`hidden`) until
     the hamburger opens them, so they cost nothing above 1080px. */
  /* z-index sits above the map's topbar (1000) and Leaflet panes so the drawer
     covers everything on /map too; on prose pages the topbar is only z-index 10. */
  .drawer-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1100;
    background: rgba(20, 18, 14, 0.45);
    opacity: 0;
    transition: opacity var(--dur-panel) var(--ease-in-out);
  }
  .drawer-backdrop.open { opacity: 1; }

  .drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    z-index: 1101;
    width: min(20rem, 86vw);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.9rem 1.1rem 1.6rem;
    background: var(--bg);
    border-right: 1px solid var(--hairline);
    box-shadow: 4px 0 28px rgba(20, 18, 14, 0.18);
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateX(-100%);
    transition: transform var(--dur-panel) var(--ease-in-out);
  }
  .drawer.open { transform: translateX(0); }

  /* `.drawer{display:flex}` would otherwise override the UA `[hidden]{display:none}`
     (author beats UA), leaving the closed drawer laid out and hit-testable — it was
     only ever "hidden" because `translateX(-100%)` parked it off-screen. That fails
     under `prefers-reduced-motion: reduce` (below), which swaps the transform for
     `opacity:0`: the panel then sits ON-screen over the left ~86vw, invisible but
     still eating taps and scroll (`overflow-y:auto` + `overscroll-behavior:contain`).
     That's the iOS "Reduce Motion" accessibility setting (and, per widespread
     reports, Low Power Mode) — so re-assert the hide with higher specificity.
     Same trap as `.ep-row` in EpisodesBody.astro. */
  .drawer[hidden],
  .drawer-backdrop[hidden] { display: none; }

  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.4rem;
  }
  .drawer-title {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .drawer-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    margin: -0.5rem -0.5rem -0.5rem 0;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .drawer-close:hover { color: var(--gold); border-color: var(--gold-soft); }

  /* Module links — the top-bar modules, restated for the narrow screen. */
  .drawer-modules {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding-bottom: 0.7rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--hairline);
  }
  .drawer-module {
    display: flex;
    align-items: center;
    min-height: 2.75rem; /* ≥44px tap target */
    padding: 0.3rem 0.4rem;
    border-radius: 8px;
    color: var(--ink-soft);
    font-weight: 500;
    font-size: 0.95rem;
  }
  .drawer-module:hover { color: var(--link-hover); text-decoration: none; }
  .drawer-module.active { color: var(--text); font-weight: 600; }
  .drawer-module.active::before {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    background: var(--gold);
    transform: rotate(45deg);
    margin-right: 0.55rem;
  }
  .drawer-module.soon { color: var(--faint); cursor: default; }
  .drawer-module.soon em {
    font-style: normal;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 1px solid var(--hairline);
    border-radius: 4px;
    padding: 0 0.28rem;
    margin-left: 0.5rem;
    color: var(--faint);
  }

  /* The reused Sidebar tree. Its `.sidenav` is `display:none` ≤1080px in the
     global shell CSS — un-hide it here, and undo the sticky/viewport-cap geometry
     so it flows naturally inside the scrolling drawer. */
  .drawer-nav .sidenav {
    display: flex;
    position: static;
    max-height: none;
    font-size: 0.9rem;
  }
  /* Bigger tap targets for the nav links inside the drawer (touch context). */
  .drawer-nav .sidenav a.nav-coll,
  .drawer-nav .sidenav a {
    padding-top: 0.32rem;
    padding-bottom: 0.32rem;
  }

  @media (prefers-reduced-motion: reduce) {
    /* No slide — cross-fade the panel instead (translation is vestibular-risky). */
    .drawer {
      transition: opacity var(--dur-panel) var(--ease-in-out);
      transform: none;
      opacity: 0;
    }
    .drawer.open { opacity: 1; }
  }

  /* Safety net: never show the drawer chrome above the collapse breakpoint, even
     mid-transition. (It's `hidden` then anyway, but this keeps desktop pristine.) */
  @media (min-width: 1081px) {
    .drawer,
    .drawer-backdrop { display: none !important; }
  }
</style>

<script is:inline>
  (function () {
    var drawer = document.querySelector('[data-drawer]');
    var backdrop = document.querySelector('[data-drawer-backdrop]');
    if (!drawer || !backdrop) return;

    var toggles = Array.prototype.slice.call(document.querySelectorAll('[data-drawer-toggle]'));
    var lastFocused = null;
    var FOCUSABLE =
      'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])';

    function isOpen() {
      return drawer.classList.contains('open');
    }

    function open() {
      if (isOpen()) return;
      lastFocused = document.activeElement;
      // Unhide before the next frame, then add `.open` so the transform animates
      // from its closed state instead of snapping.
      drawer.hidden = false;
      backdrop.hidden = false;
      drawer.setAttribute('aria-hidden', 'false');
      // The drawer is now genuinely `display:none` while hidden (see the
      // `.drawer[hidden]` rule), so flush layout here: without it the unhide and
      // the `.open` class can collapse into one style recalc and the panel snaps
      // open instead of sliding.
      void drawer.offsetWidth;
      requestAnimationFrame(function () {
        drawer.classList.add('open');
        backdrop.classList.add('open');
      });
      document.body.style.overflow = 'hidden';
      toggles.forEach(function (t) {
        t.setAttribute('aria-expanded', 'true');
      });
      document.addEventListener('keydown', onKeydown, true);
      // Move focus into the drawer (the close button) for keyboard users.
      var closeBtn = drawer.querySelector('[data-drawer-close]');
      if (closeBtn) closeBtn.focus();
    }

    function close(restoreFocus) {
      if (!isOpen()) return;
      drawer.classList.remove('open');
      backdrop.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      toggles.forEach(function (t) {
        t.setAttribute('aria-expanded', 'false');
      });
      document.removeEventListener('keydown', onKeydown, true);
      // Re-hide after the slide-out finishes so it's inert again (and `hidden`
      // can't trap focus). Tie it to the transition; fall back on a timer.
      var done = false;
      function finish() {
        if (done) return;
        done = true;
        drawer.hidden = true;
        backdrop.hidden = true;
        drawer.removeEventListener('transitionend', finish);
      }
      drawer.addEventListener('transitionend', finish);
      setTimeout(finish, 400);
      if (restoreFocus !== false && lastFocused && lastFocused.focus) lastFocused.focus();
    }

    function onKeydown(e) {
      if (e.key === 'Escape') {
        e.preventDefault();
        close(true);
        return;
      }
      if (e.key === 'Tab') {
        // Trap focus within the drawer.
        var nodes = Array.prototype.slice
          .call(drawer.querySelectorAll(FOCUSABLE))
          .filter(function (el) {
            return el.offsetParent !== null;
          });
        if (!nodes.length) return;
        var first = nodes[0];
        var last = nodes[nodes.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }

    toggles.forEach(function (t) {
      t.addEventListener('click', function () {
        isOpen() ? close(true) : open();
      });
    });
    backdrop.addEventListener('click', function () {
      close(true);
    });
    var closeBtn = drawer.querySelector('[data-drawer-close]');
    if (closeBtn)
      closeBtn.addEventListener('click', function () {
        close(true);
      });
    // Tapping any link inside the drawer navigates — close without yanking focus
    // back (the navigation takes over). In-page (#hash) links stay on the page,
    // so close normally there.
    drawer.addEventListener('click', function (e) {
      var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
      if (a) close(false);
    });
  })();
</script>

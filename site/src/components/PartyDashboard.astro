    font-size: 0.82rem;
    margin: 0.4rem 0 0;
  }

  /* Pin/peek a character → dim badges with no active holder dot inside. */
  .party-dash.is-filtering .pd-badge:not(:has(.is-active)) {
    opacity: 0.2;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-char],
    .pd-poly,
    .pd-arc,
    .pd-badge {
      transition: none;
    }
  }

  /* Phone (≤480): the legend names + the spell/feat filter chips are the primary
     touch controls (tap = spotlight, see Phase 3), so grow them to a comfortable
     ~44px target. Tighter card padding reclaims width on a 390px screen. */
  @media (max-width: 480px) {
    /* Dense wrapping legend of 10 names — a comfortable inline target without the
       bulk a full 44px would add to ten chips. The few segmented/filter toggles
       below it get the full 44px since they're the primary, sparse controls. */
    .pd-chip { min-height: 2.5rem; padding: 0.4rem 0.8rem 0.4rem 0.6rem; }
    .pd-seg-btn { min-height: 2.75rem; }
    .pd-cat,
    .pd-solo { min-height: 2.75rem; }
  }
</style>

<script>
  // Touch devices have no real hover: skip the transient peek listeners so the only
  // interaction is tap = pin (routed to the same toggleLock path as desktop click),
  // and synthesized mouse events can't leave a chip stuck in a peeked/hover state.
  const canHover = window.matchMedia('(hover: hover)').matches;

  for (const dash of document.querySelectorAll<HTMLElement>('.party-dash')) {
    const chips = Array.from(dash.querySelectorAll<HTMLElement>('.pd-chip'));
    const marks = Array.from(dash.querySelectorAll<HTMLElement>('[data-char]'));
    const clearBtn = dash.querySelector<HTMLElement>('.pd-clear');
    const locked = new Set<string>();

    // `peek` = transient hover spotlight (legend chips only); `locked` = pinned set.
    let peek: string[] = [];
    const rerender = () => {
      const active = new Set(locked);
      for (const p of peek) active.add(p);
      dash.classList.toggle('is-filtering', active.size > 0);
      for (const el of marks) {
        el.classList.toggle('is-active', active.has(el.dataset.char ?? ''));
      }
      for (const c of chips) {
        const key = c.dataset.char ?? '';
        c.classList.toggle('is-active', active.has(key));
        c.classList.toggle('is-locked', locked.has(key));
        c.setAttribute('aria-pressed', String(locked.has(key)));
      }
      if (clearBtn) clearBtn.hidden = locked.size === 0;
    };
    const setPeek = (keys: string[]) => { peek = keys; rerender(); };
    const toggleLock = (keys: string[]) => {
      // Toggle the whole set together: if all are already pinned, unpin; else pin.
      const allLocked = keys.length > 0 && keys.every((k) => locked.has(k));
      for (const k of keys) (allLocked ? locked.delete(k) : locked.add(k));
      rerender();
    };

    // Keep the sticky legend's offset equal to the *actual* sticky header height.
    // A fixed rem offset clips it: ≤1080 the topbar wraps to two (taller) rows and
    // the breadcrumb stops being sticky, so measure both and track on resize.
    const legendWrap = dash.querySelector<HTMLElement>('.pd-legend-wrap');
    if (legendWrap) {
      const topbar = document.querySelector<HTMLElement>('.topbar');
      const crumb = document.querySelector<HTMLElement>('.crumb');
      const setStick = () => {
        const tb = topbar?.offsetHeight ?? 0;
        const cb = crumb && getComputedStyle(crumb).position === 'sticky' ? crumb.offsetHeight : 0;
        legendWrap.style.top = `${tb + cb}px`;
      };
      setStick();
      window.addEventListener('resize', setStick);
    }

    // Deep-link: /characters?focus=slug[,slug] (a character dossier's "Compare in
    // roster" button) arrives with those members pre-pinned in the comparison.
    try {
      const focus = new URLSearchParams(location.search).get('focus');
      if (focus) {
        const valid = new Set(chips.map((c) => c.dataset.char ?? ''));
        const wanted = focus.split(',').map((s) => s.trim()).filter((s) => valid.has(s));
        if (wanted.length) {
          for (const k of wanted) locked.add(k);
          rerender();
        }
      }
    } catch (e) {}

    // Legend name buttons are the gentle entry point: peek on hover/focus, pin on
    // click. (Hover-spotlighting every chart mark was too twitchy with this many.)
    for (const chip of chips) {
      const key = chip.dataset.char ?? '';
      if (!key) continue;
      if (canHover) {
        chip.addEventListener('mouseenter', () => setPeek([key]));
        chip.addEventListener('mouseleave', () => setPeek([]));
        chip.addEventListener('focus', () => setPeek([key]));
        chip.addEventListener('blur', () => setPeek([]));
      }
      chip.addEventListener('click', () => toggleLock([key]));
    }

    // Every OTHER chart mark pins ON CLICK ONLY — no hover. Skip the legend chips
    // (handled above), badge holder-dots (the badge handles its own click), and
    // the alignment <a> chips (those navigate to the character page).
    for (const el of marks) {
      const key = el.dataset.char ?? '';
      if (!key || el.classList.contains('pd-chip') || el.closest('a') || el.closest('.pd-badge')) continue;
      el.classList.add('pd-clickable');
      el.addEventListener('click', () => toggleLock([key]));
    }

    // A spellbook/feat badge pins its WHOLE holder set on click.
    for (const badge of dash.querySelectorAll<HTMLElement>('.pd-badge')) {
      const holders = (badge.dataset.holders ?? '').split(',').filter(Boolean);
      if (!holders.length) continue;
      badge.addEventListener('click', () => toggleLock(holders));
    }

    // Live filtering over the badge wall: free-text search + a single spell-type
    // category + a "solo only" (single point of failure) toggle, ANDed together.
    // Hides non-matching badges, empty level rows, and shows a per-pane note.
    const search = dash.querySelector<HTMLInputElement>('.pd-spell-search');
    const panes = Array.from(dash.querySelectorAll<HTMLElement>('.pd-pane'));
    const catBtns = Array.from(dash.querySelectorAll<HTMLElement>('.pd-cat'));
    let activeCat: string | null = null;

    const applyFilters = () => {
      const q = (search?.value ?? '').trim().toLowerCase();
      for (const pane of panes) {
        const soloBtn = pane.querySelector<HTMLElement>('.pd-solo');
        const solo = soloBtn?.getAttribute('aria-pressed') === 'true';
        let anyVisible = false;
        for (const badge of pane.querySelectorAll<HTMLElement>('.pd-badge')) {
          const nameHit = !q || (badge.dataset.name ?? '').includes(q);
          // Feats carry no data-cat → they ignore the (spells-only) category filter.
          const cats = badge.dataset.cat;
          const catHit = !activeCat || cats === undefined || cats.split(' ').includes(activeCat);
          const soloHit = !solo || badge.dataset.soloBadge === '1';
          const hit = nameHit && catHit && soloHit;
          badge.classList.toggle('pd-badge--hidden', !hit);
          if (hit) anyVisible = true;
        }
        for (const row of pane.querySelectorAll<HTMLElement>('.pd-srow')) {
          row.classList.toggle('pd-badge--hidden', !row.querySelector('.pd-badge:not(.pd-badge--hidden)'));
        }
        const noMatch = pane.querySelector<HTMLElement>('.pd-no-match');
        if (noMatch) noMatch.hidden = anyVisible;
      }
    };
    search?.addEventListener('input', applyFilters);

    // Category chips — single-select (click the active one to clear).
    for (const btn of catBtns) {
      btn.addEventListener('click', () => {
        activeCat = activeCat === btn.dataset.catBtn ? null : (btn.dataset.catBtn ?? null);
        for (const b of catBtns) b.setAttribute('aria-pressed', String(b.dataset.catBtn === activeCat));
        applyFilters();
      });
    }

    // "Solo only" toggles per pane (single point of failure).
    for (const soloBtn of dash.querySelectorAll<HTMLElement>('.pd-solo')) {
      soloBtn.addEventListener('click', () => {
        soloBtn.setAttribute('aria-pressed', String(soloBtn.getAttribute('aria-pressed') !== 'true'));
        applyFilters();
      });
    }

    // Spells | Feats toggle — flips which pane the card shows.
    const card = dash.querySelector<HTMLElement>('.pd-card--spells');
    const segBtns = Array.from(dash.querySelectorAll<HTMLElement>('.pd-seg-btn'));
    for (const btn of segBtns) {
      btn.addEventListener('click', () => {
        if (card) card.dataset.view = btn.dataset.viewBtn ?? 'spells';
        for (const b of segBtns) {
          const on = b === btn;
          b.classList.toggle('is-on', on);
          b.setAttribute('aria-pressed', String(on));
        }
      });
    }

    if (canHover) {
      dash.addEventListener('mouseleave', () => setPeek([]));
      dash.addEventListener('focusout', (e) => {
        if (!dash.contains((e as FocusEvent).relatedTarget as Node)) setPeek([]);
      });
    }
    clearBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      locked.clear();
      setPeek([]);
    });
  }
</script>

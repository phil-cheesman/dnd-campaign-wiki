    color: var(--ink-soft);
    cursor: pointer;
    transition:
      opacity var(--dur-state) var(--ease-out),
      border-color var(--dur-instant) var(--ease-out);
  }
  @media (hover: hover) {
    .pd-badge:hover {
      border-color: color-mix(in srgb, var(--gold) 60%, var(--hairline));
    }
  }
  .pd-badge-name {
    white-space: nowrap;
  }
  .pd-dots {
    display: inline-flex;
    gap: 2px;
  }
  .pd-dot {
